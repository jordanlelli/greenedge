{
  "name": "universal-template",
  "type": "module",
  "version": "3.34.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-design.mjs && node scripts/check-catalogue.mjs && node scripts/check-universal.mjs && node scripts/check-intake.mjs && node scripts/check-service-prices.mjs && astro build && node scripts/check-fonts.mjs",
    "build:force-placeholders": "node scripts/check-universal.mjs && node scripts/check-intake.mjs && node scripts/check-service-prices.mjs --allow-placeholders && astro build && node scripts/check-fonts.mjs",
    "check:prices": "node scripts/check-service-prices.mjs",
    "preview": "astro preview",
    "variants": "node scripts/pick-variants.mjs",
    "picks": "node scripts/apply-picks.mjs",
    "verify:lock": "node scripts/verify-lock.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "regen": "npm run variants && npm run build",
    "fresh": "npm run clean && npm run variants && npm run build",
    "qa": "node scripts/qa.mjs",
    "demo": "node scripts/with-intake.mjs client-intake.demo.json npm run build",
    "qa:demo": "npm run demo && node scripts/qa.mjs",
    "qa:layout": "node scripts/check-layout.mjs",
    "qa:src": "npx --yes impeccable@3 detect src",
    "qa:static": "npx --yes impeccable@3 detect dist",
    "check:universal": "node scripts/check-universal.mjs --report",
    "check:presets": "node scripts/check-presets.mjs --verbose",
    "palette": "node scripts/check-universal.mjs --report",
    "check:intake": "node scripts/check-intake.mjs",
    "new-client": "node scripts/new-client.mjs",
    "preflight": "node scripts/check-universal.mjs --report && node scripts/check-intake.mjs",
    "check:catalogue": "node scripts/check-catalogue.mjs",
    "design": "node scripts/check-design.mjs",
    "check:fonts": "node scripts/check-fonts.mjs",
    "template:status": "node scripts/template-sync.mjs status",
    "template:init": "node scripts/template-sync.mjs init",
    "template:pull": "node scripts/template-sync.mjs pull",
    "template:lock": "node scripts/template-sync.mjs lock",
    "template:unlock": "node scripts/template-sync.mjs unlock",
    "template:import": "node scripts/template-sync.mjs import",
    "template:release": "node scripts/template-sync.mjs release",
    "test:sync": "node scripts/test-template-sync.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/abril-fatface": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/big-shoulders": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/jaro": "^5.3.0",
    "@fontsource/kanit": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/protest-strike": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@fontsource/saira-stencil-one": "^5.3.0",
    "@fontsource/shrikhand": "^5.3.0",
    "@fontsource/sofia-sans-extra-condensed": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/young-serif": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^7.3.5",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  }
}
