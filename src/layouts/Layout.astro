---
import "../styles/global.css";
import { Font, getImage } from "astro:assets";
import { localImage } from "../lib/images";
import { site, layout, fullAddress } from "../config";
// @ts-ignore — plain-JS palette engine shared with the Node check scripts
import { resolvePalette, paletteToStyleAttr } from "../lib/palette.mjs";
import { services as serviceCatalog } from "../data/services";
// @ts-ignore — plain-JS normalisers shared with the Node check scripts
import { resolveServicesPage, resolveBusinessSchema } from "../lib/content.mjs";
// @ts-ignore — plain-JS page gate
import { pageIsBuilt } from "../lib/pages.mjs";
import TodoBanner from "../components/TodoBanner.astro";
import StickyPhoneBar from "../components/StickyPhoneBar.astro";
import Analytics from "../components/Analytics.astro";
import ConsentBanner from "../components/ConsentBanner.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  pageType?: "home" | "about" | "services" | "contact" | "area" | "other";
  canonicalUrl?: string;
  robots?: string;
}

const {
  title = site.seo?.title || `${site.business?.name} — ${site.business?.tagline}`,
  description = site.seo?.description || site.business?.shortDescription || site.business?.tagline,
  ogImage = site.seo?.ogImage || "",
  pageType = "other",
  canonicalUrl,
  robots = "",
} = Astro.props;

/* ---- CLIENT PALETTE -------------------------------------------------------
   The kit class drives type/radius/shadow (see global.css); these --c-* vars
   drive colour, and the semantic tokens in global.css read them.

   All of the derivation lives in src/lib/palette.mjs so it is testable outside
   a browser and so there is exactly ONE place that answers "where did this
   colour come from?". The contract: every colour is either stated by the client
   in intake `style`, or derived from style.brand / style.accent. Nothing here
   may contain a coloured literal — scripts/check-universal.mjs enforces it.
   Run `npm run check:palette` to see the resolved palette + contrast report. */
const cssVars = resolvePalette(site, layout.surface || "flat");
/* Style Picker type vars (weights, width, case, headline scale) sit on <html>
   beside the palette, where they override the kit class's tokens. */
const type = layout.type;

/* SAMPLE CONTENT (v3.27). demo.sampleSections lists the sections whose copy
   was written to show a finished build, not taken from the business. Each one
   gets a small red "Sample content" tag (global.css, [data-sample]), on every
   page it appears on. Section key -> the id its component renders. */
const SAMPLE_IDS: Record<string, string> = { whyUs: "why-us", faq: "faqs", areas: "usage", recentJobs: "recent-jobs", beforeAfter: "before-after" };
const sampleIds: string[] = (Array.isArray(site.demo?.sampleSections) ? site.demo.sampleSections : [])
  .filter((k: unknown) => typeof k === "string" && /^[a-zA-Z-]+$/.test(k))
  .flatMap((k: string) => (k === "areas" ? ["usage", "areas"] : [SAMPLE_IDS[k] || k]));

/* Scroll motion level: standard | subtle | bold (v3.26) | off. Anything else is standard. */
const motion = ["subtle", "bold", "off"].includes(site.features?.motion) ? site.features.motion : "standard";
const styleStr = paletteToStyleAttr({ ...cssVars, ...(type?.vars || {}) });

/* ---- SEO + schema (preserved) --------------------------------------------- */
/* SITE-WIDE NOINDEX.
   There was no control for this, and `robots` defaulted to "index, follow" — so
   a cold-outreach demo, built from draft copy for a business that has not been
   contacted, was fully indexable on its Vercel URL. That is a live page with a
   real business's name, real reviews and unapproved copy competing with their
   own listing. seo.noindex flips the whole site (and robots.txt) in one place. */
const siteNoindex = site.seo?.noindex === true;
const robotsValue = siteNoindex ? "noindex, nofollow" : robots || "index, follow";
const siteUrl = Astro.site?.href || "";
const canonical = canonicalUrl || (siteUrl ? `${siteUrl.replace(/\/$/, "")}${Astro.url.pathname}` : "");

/* ---- SOCIAL SHARE IMAGE ----------------------------------------------------
   og:image MUST be an absolute URL. Facebook, LinkedIn, WhatsApp and iMessage
   all refuse to resolve a relative path, so `/favicon.png` produced a share card
   with no image on every client site ever built from this template. That matters
   more here than on most sites: pasting the link into Facebook is often the first
   thing a tradie does with a new site, in front of exactly the audience it was
   built for.

   Preference order, and the reasoning:
     1. seo.ogImage      — a purpose-made 1200x630 card, if the client has one.
     2. hero.image       — a real job photo beats no photo, and it is already
                           the most considered image on the site. SKIPPED
                           when hero.imageIsStock is true (v3.20): the link
                           preview is the first image people see of the
                           business, and a stock photo there misrepresents it.
     3. first owned service photo (features.hasPhotos + items[].image).
     4. nothing          — deliberately NOT the favicon. A 512px square in a
                           1.91:1 card renders as a letterboxed smear, and
                           anything under 200x200 is dropped by Facebook
                           outright. An unstyled link preview beats a broken one.
   -------------------------------------------------------------------------- */
const heroShareImage = site.hero?.imageIsStock === true ? "" : site.hero?.image || "";
const serviceShareImage = resolveServicesPage(site).withImages[0]?.image || "";
const rawShareImagePath = ogImage || heroShareImage || serviceShareImage;
/* v3.21: a hero or service photo that lives in src/assets has no public URL of
   its own (only hashed variants), so the fallback share image is a 1200px JPEG
   generated from it — which is also what a scraper wants, not a 5 MB master.
   seo.ogImage is left alone: it stays a stable public/ path by design. */
const shareAsset = rawShareImagePath && rawShareImagePath !== ogImage ? localImage(rawShareImagePath) : null;
const rawShareImage = shareAsset
  ? (await getImage({ src: shareAsset, width: Math.min(1200, shareAsset.width), format: "jpg", quality: 80 })).src
  : rawShareImagePath;
const absoluteUrl = (path: string): string => {
  if (!path) return "";
  if (/^https?:\/\//i.test(path)) return path;
  if (!siteUrl) return "";
  try {
    return new URL(path, siteUrl).href;
  } catch {
    return "";
  }
};
const shareImage = absoluteUrl(rawShareImage);
const shareImageAlt = site.seo?.ogImageAlt || site.business?.name || "";

/* v3.20: type, phone, sameAs, logo, image, opening hours and the services
   catalogue come from resolveBusinessSchema (content.mjs) so check-intake
   can validate the same inputs. */
const localBusinessSchema: Record<string, unknown> = resolveBusinessSchema(site, {
  siteUrl,
  imageUrl: shareImage,
  logoUrl: absoluteUrl(site.business?.logo || ""),
  servicesUrl: pageIsBuilt("services", site, { serviceRecords: serviceCatalog }) ? absoluteUrl("/services") : "",
});
if (fullAddress()) {
  const addr = fullAddress();
  const parsed = addr.match(/^(.+?)\s+(SA|NSW|VIC|QLD|WA|TAS|NT|ACT)\s+(\d{4})$/i);
  localBusinessSchema.address = parsed
    ? {
        "@type": "PostalAddress",
        addressLocality: parsed[1].trim(),
        addressRegion: parsed[2].toUpperCase(),
        postalCode: parsed[3],
        addressCountry: "AU",
      }
    : {
        "@type": "PostalAddress",
        streetAddress: addr,
        addressCountry: "AU",
      };
}
if (site.business?.abn) {
  localBusinessSchema.taxID = site.business.abn;
}
const serviceAreas = site.usage?.items || [];
if (serviceAreas.length) {
  localBusinessSchema.areaServed = serviceAreas.map((area: string) => ({ "@type": "Place", name: area }));
}
// TODO(review-schema): Add Review/AggregateRating JSON-LD only after testimonials.ts
// contains real reviews and every entry has a verified sourceUrl. Never infer ratings.

/* FAQPage markup only where the questions are VISIBLE (v3.20): the homepage
   when `faqs` is in sections, and /faq. It used to be emitted on every page
   whenever the intake had FAQs — including sites where no FAQ was shown
   anywhere, which is exactly what Google's structured-data guidelines forbid
   (markup must describe content on the page). */
let faqSchema: Record<string, unknown> | null = null;
const faqItems = (site.faqs?.items || []).filter((i: any) => i && i.question && i.answer);
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const faqVisibleHere =
  (path === "/" && (site.sections || []).includes("faqs")) || path === "/faq";
if (faqItems.length > 0 && faqVisibleHere) {
  faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item: { question: string; answer: string }) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  };
}

const servicesSchema =
  serviceCatalog.length > 0
    ? serviceCatalog.map((service) => ({
        "@context": "https://schema.org",
        "@type": "Service",
        name: service.name,
        description: service.shortLine,
        provider: { "@type": "LocalBusiness", name: site.business?.name },
        areaServed: serviceAreas,
      }))
    : null;
---

<!doctype html>
<html lang="en-AU" class={`kit-${layout.kit}`} style={styleStr} data-motion={motion} data-sample-sections={sampleIds.length ? sampleIds.join(" ") : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* <meta name="keywords"> removed in v3.12. Google stopped using it in 2009
        and has said so publicly; Bing treats stuffing it as a negative signal.
        It only ever showed competitors the terms you were targeting. The intake
        key stays — a client's keyword list is still useful input for writing
        copy and picking service-area pages, it just does not belong in a tag. */}
    <meta name="robots" content={robotsValue} />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {shareImage && (
      <>
        <meta property="og:image" content={shareImage} />
        <meta property="og:image:alt" content={shareImageAlt} />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_AU" />
    {canonical && <meta property="og:url" content={canonical} />}

    <meta name="twitter:card" content={shareImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {shareImage && <meta name="twitter:image" content={shareImage} />}

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    {type?.hero && <Font cssVariable="--font-hero" preload />}

    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    {servicesSchema?.map((sc) => (
      <script type="application/ld+json" set:html={JSON.stringify(sc)} />
    ))}

    <Analytics />
  </head>

  <body id="top" class="overflow-x-clip bg-bg font-body text-ink antialiased">
    <slot />
    <StickyPhoneBar />
    <ConsentBanner />
    <TodoBanner />

    {/* ---- SCROLL REVEAL (motion layer) --------------------------------------
         Global, dependency-free. The hidden state (.reveal) is applied by JS
         ONLY — if JS fails or IntersectionObserver is unsupported, nothing is
         ever hidden. Fully disabled under prefers-reduced-motion. Targets
         section[id], which matches content sections and excludes the hero
         (no id) and header/footer. Opt a section out with data-no-reveal. --- */}
    <style is:global>
      @media (prefers-reduced-motion: no-preference) {
        .reveal {
          opacity: 0;
          transform: translateY(var(--rv-dist, 1.25rem));
          transition:
            opacity var(--rv-dur, 0.6s) cubic-bezier(0.16, 1, 0.3, 1),
            transform var(--rv-dur, 0.6s) cubic-bezier(0.16, 1, 0.3, 1);
          will-change: opacity, transform;
        }
        .reveal.is-visible {
          opacity: 1;
          transform: none;
        }

        /* Opt-in staggered child reveal: a section marked data-reveal="stagger"
           cascades its [data-reveal-item] children. Inert unless both attributes
           are present. */
        .reveal-item {
          opacity: 0;
          transform: translateY(var(--rv-item-dist, 1rem));
          transition:
            opacity var(--rv-dur, 0.6s) cubic-bezier(0.16, 1, 0.3, 1),
            transform var(--rv-dur, 0.6s) cubic-bezier(0.16, 1, 0.3, 1);
          transition-delay: var(--rvd, 0ms);
          will-change: opacity, transform;
        }
        .reveal-item.is-visible {
          opacity: 1;
          transform: none;
        }

        /* SIDE ENTRANCES (v3.26, features.motion "bold" only). The two halves
           of a two-part section come in from opposite sides. Only from the
           width where they actually sit side by side: stacked in one column
           they keep the plain rise above, because sideways travel on a phone
           reads as a glitch. body is overflow-x: clip, so nothing scrolls. */
        @media (min-width: 64rem) {
          .reveal-item[data-reveal-from="left"]:not(.is-visible) {
            transform: translateX(calc(-1 * var(--rv-side, 4.5rem)));
          }
          .reveal-item[data-reveal-from="right"]:not(.is-visible) {
            transform: translateX(var(--rv-side, 4.5rem));
          }
        }
      }
    </style>
    {sampleIds.length > 0 && (
      <script is:inline define:vars={{ sampleIds }}>
        for (const id of sampleIds) {
          const el = document.getElementById(id);
          if (el) el.setAttribute("data-sample", "");
        }
      </script>
    )}
    <script>
      (() => {
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const level = document.documentElement.dataset.motion || "standard";
        if (reduce || level === "off" || !("IntersectionObserver" in window)) return;

        const sections = Array.from(
          document.querySelectorAll<HTMLElement>("section[id]:not([data-no-reveal])")
        );
        if (!sections.length) return;

        const staggerItems = (el: HTMLElement) =>
          el.dataset.reveal === "stagger"
            ? Array.from(el.querySelectorAll<HTMLElement>("[data-reveal-item]"))
            : [];

        const io = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              el.classList.add("is-visible");
              staggerItems(el).forEach((c) => c.classList.add("is-visible"));
              obs.unobserve(el);
            });
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.08 }
        );

        /* The section sliding over a pinned hero must stay opaque, or the hero
           shows through it until it fades in. Its items still cascade. */
        const cover = document.querySelector(".hero-cover");
        let afterCover: Element | null = cover ? cover.nextElementSibling : null;
        while (afterCover && !afterCover.matches("section[id]") && !afterCover.querySelector("section[id]")) {
          afterCover = afterCover.nextElementSibling;
        }
        if (afterCover && !afterCover.matches("section[id]")) afterCover = afterCover.querySelector("section[id]");

        /* v3.25: a stagger section fades in as a whole AND cascades its items,
           so its heading no longer sits there before the grid arrives. */
        const STEP = level === "subtle" ? 60 : 90, CAP = 8;
        sections.forEach((el) => {
          staggerItems(el).forEach((c, i) => {
            c.classList.add("reveal-item");
            c.style.setProperty("--rvd", `${Math.min(i, CAP) * STEP}ms`);
          });
          if (el !== afterCover) el.classList.add("reveal");
          io.observe(el);
        });

        /* v3.26 bold: each marked half is watched on its own, so a row far down
           a long section moves when IT arrives, not when the section does. */
        if (level === "bold") {
          const sideIo = new IntersectionObserver(
            (entries, obs) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add("is-visible");
                obs.unobserve(entry.target);
              });
            },
            { rootMargin: "0px 0px -12% 0px", threshold: 0.05 }
          );
          document
            .querySelectorAll<HTMLElement>("section[id]:not([data-no-reveal]) [data-reveal-from]")
            .forEach((el) => {
              el.classList.add("reveal-item");
              sideIo.observe(el);
            });
        }
      })();
    </script>
    <script>
      /* v3.21 — fetch every remaining image once the page is ready.
         loading="lazy" defers each image until it nears the viewport, and an
         image inside a hidden panel (services index, accordions) until it is
         shown, so every click or scroll paid a fresh round trip. Once the page
         has loaded and the main thread is idle, every lazy image is flipped to
         eager: the browser fetches them in the background at low priority and
         later interactions hit the cache. This runs AFTER load, so it cannot
         delay first paint or LCP. The one exception is Save-Data: a visitor
         who has told the browser to save data has asked for exactly this not
         to happen. */
      (() => {
        const conn = (navigator as any).connection;
        if (conn?.saveData === true) return;
        const warmAll = () =>
          document.querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((img) => {
            img.loading = "eager";
          });
        const idle = (fn: () => void) =>
          "requestIdleCallback" in window ? (window as any).requestIdleCallback(fn, { timeout: 2000 }) : setTimeout(fn, 1000);
        if (document.readyState === "complete") idle(warmAll);
        else window.addEventListener("load", () => idle(warmAll), { once: true });
      })();
    </script>
  </body>
</html>
