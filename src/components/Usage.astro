---
/**
 * Usage — full service-area list for /areas only.
 * Homepage areas live in Story.astro (right column of the merged about block).
 */
import { site } from "../config";
import Section from "./Section.astro";

interface Props {
  /** When true, show the full suburb list (areas page). Default: featured core. */
  full?: boolean;
  /** Heading level. /areas is a page in its own right and had NO h1 at all —
      pre-existing since at least v3.15, while /services and /faq both had one.
      A page with no h1 is a real accessibility and SEO defect, not a style
      choice. */
  as?: "h1" | "h2";
}

const { full = false, as: HeadingTag = "h2" } = Astro.props;

const usage = site.usage || {};
const allItems: string[] = usage.items || [];
const featured: string[] =
  (Array.isArray(usage.featured) && usage.featured.length > 0
    ? usage.featured
    : allItems.slice(0, 8)) as string[];
const items = full ? allItems : featured;
const heading = usage.heading || "Service areas";
const eyebrow = usage.eyebrow || "";
const subhead = usage.subhead || "";
const showAreasLink = !full && allItems.length > featured.length;
---

{items.length > 0 && (
  <Section id="usage" bg="bg" pad="tight">
    <div class="max-w-2xl">
      {eyebrow && (
        <p class="section-eyebrow text-[0.6875rem] font-semibold uppercase leading-[1.4] tracking-[0.14em] text-brand-secondary-ink">{eyebrow}</p>
      )}
      <HeadingTag class:list={["section-heading font-heading text-3xl font-semibold tracking-tight text-brand sm:text-4xl", eyebrow && "mt-2"]}>
        {heading}
      </HeadingTag>
      {subhead && <p class="mt-3 text-base leading-relaxed text-muted">{subhead}</p>}
    </div>

    <ul class="mt-8 flex flex-wrap gap-2">
      {items.map((area: string) => (
        <li class="rounded-full border border-border bg-card px-4 py-2 text-sm font-medium text-brand">
          {area}
        </li>
      ))}
    </ul>

    {showAreasLink && (
      <p class="mt-6">
        <a
          href="/areas"
          class="text-sm font-semibold text-brand underline-offset-4 transition hover:underline"
        >
          See all service areas
        </a>
      </p>
    )}
  </Section>
)}
