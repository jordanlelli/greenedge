---
/**
 * SectionHead — eyebrow + heading + subhead for a content section.
 *
 * Four components each rendered their own heading block and only some of them
 * read `eyebrow`, so `usage.eyebrow`, `story.eyebrow`, `contactSection.eyebrow`
 * and `services.heading` sat in every client intake doing nothing. Clients write
 * those — they are the short orienting line above a section heading and the one
 * piece of section copy a tradie reliably has an opinion about.
 *
 * One component so the next section added cannot forget the eyebrow again.
 */
interface Props {
  eyebrow?: string;
  heading: string;
  subhead?: string;
  class?: string;
  headingClass?: string;
}
const {
  eyebrow = "",
  heading,
  subhead = "",
  class: extra = "",
  headingClass = "section-heading font-heading font-semibold tracking-tight text-brand",
} = Astro.props;
---

<div class:list={["max-w-[46rem]", extra]}>
  {eyebrow && (
    <p class="section-eyebrow text-[0.6875rem] font-semibold uppercase leading-[1.4] tracking-[0.14em] text-brand-secondary-ink">
      {eyebrow}
    </p>
  )}
  <h2 class:list={[eyebrow && "mt-2", headingClass]}>{heading}</h2>
  {subhead && <p class="mt-3 text-base leading-relaxed text-muted">{subhead}</p>}
</div>
