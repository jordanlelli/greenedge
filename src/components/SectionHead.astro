---
/**
 * SectionHead — eyebrow + heading + subhead for a content section.
 *
 * Four components each rendered their own heading block and only some of them
 * read `eyebrow`, so `usage.eyebrow`, `story.eyebrow`, `contactSection.eyebrow`
 * and `services.heading` sat in every client intake doing nothing. Clients write
 * those — they are the short orienting line above a section heading and the one
 * piece of section copy a tradie reliably has an opinion about.
 *
 * One component so the next section added cannot forget the eyebrow again.
 */
interface Props {
  eyebrow?: string;
  heading: string;
  subhead?: string;
  class?: string;
  headingClass?: string;
}
const {
  eyebrow = "",
  heading,
  subhead = "",
  class: extra = "",
  headingClass = "section-heading font-heading text-3xl font-semibold tracking-tight text-brand sm:text-4xl lg:text-[2.75rem] lg:leading-[1.1]",
} = Astro.props;
---

<div class:list={["max-w-2xl lg:max-w-3xl", extra]}>
  {eyebrow && (
    <p class="section-eyebrow text-brand-secondary-ink">
      {eyebrow}
    </p>
  )}
  <h2 class:list={[eyebrow && "mt-3", headingClass]}>{heading}</h2>
  {subhead && <p class="mt-4 max-w-[40rem] text-base leading-[1.65] text-muted lg:text-[1.0625rem]">{subhead}</p>}
</div>
