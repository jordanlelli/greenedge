---
/**
 * ServicesSplitScroll — alternating full-width image/text rows.
 *
 * Gated on MOST shown items (2/3) having a REAL photo (features.hasPhotos
 * + a per-item image); a service without one renders as a full-width text
 * row. A per-service image asserts the client did that specific job, so a
 * placeholder path is not enough — see hasOwnedPhotos in content.mjs.
 *
 * The image side flips each row on desktop. On mobile the text always comes
 * first regardless of row parity: alternating on a single column produces no
 * visual rhythm, only an inconsistent reading order.
 */
// @ts-ignore — plain-JS helper shared with the Node check scripts
import { midSentence } from "../../lib/content.mjs";
import Img from "../Img.astro";
interface Props { items: any[]; }
const { items } = Astro.props;
/* Alternation counts PHOTO rows only, so a text row in between does not make
   two photos land on the same side. */
let photoIndex = 0;
const rows = items.map((it: any, i: number) => ({ ...it, ord: i + 1, flip: it.image ? photoIndex++ % 2 === 1 : false }));
---

<div class="svc-scroll">
  {rows.map((it: any) => (
    <div class:list={["svc-scroll-row", it.flip && "svc-scroll-row--flip", !it.image && "svc-scroll-row--text"]}>
      <div class="svc-scroll-text" data-reveal-from={it.flip ? "right" : "left"}>
        <p class="svc-scroll-ord" aria-hidden="true">{String(it.ord).padStart(2, "0")}</p>
        <h3 class="mt-2 font-heading text-2xl font-semibold leading-tight text-brand lg:text-[1.75rem]">{it.title}</h3>
        {it.description && (
          <p class="mt-3 text-base leading-relaxed text-muted">{it.description}</p>
        )}
        {it.longDescription && (
          <p class="mt-3 text-base leading-relaxed text-muted">{it.longDescription}</p>
        )}
        {it.image && it.includes.length > 0 && (
          <ul class="mt-4 space-y-2">
            {it.includes.slice(0, 5).map((inc: string) => (
              <li class="flex gap-2 text-sm leading-snug text-ink">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-highlight" aria-hidden="true"></span>
                <span>{inc}</span>
              </li>
            ))}
          </ul>
        )}
        {it.image && it.price && (
          <p class="mt-4 font-heading text-lg font-semibold text-brand lg:text-xl">{it.price}</p>
        )}
        {it.image && it.href && (
          <p class="mt-4">
            <a href={it.href} class="inline-flex min-h-11 items-center font-semibold text-brand underline-offset-4 hover:underline">
              More on {it.title} <span class="ml-2" aria-hidden="true">→</span>
            </a>
          </p>
        )}
      </div>
      {/* NO PHOTO = A FULL-WIDTH TEXT ROW (v3.20), not an empty grey panel.
          The blank placeholder held the row's shape for a photo still to come,
          but on a live site it read as a broken image. Now the row runs as two
          text columns — copy left, inclusions / price / link right — and
          switches to image + text on its own once items[].image is set. */}
      {it.image ? (
        <div class="svc-scroll-media" data-reveal-from={it.flip ? "left" : "right"}>
          <Img sizes="(min-width: 1024px) 50vw, 100vw" src={it.image} alt={it.imageAlt} loading="lazy" decoding="async" width="800" height="600" />
        </div>
      ) : (
        <div class="svc-scroll-aside" data-reveal-from={it.flip ? "left" : "right"}>
            {it.includes.length > 0 && (
              <p class="mb-3 text-[0.75rem] font-bold uppercase tracking-[0.14em] text-muted">What's included</p>
            )}
            {it.includes.length > 0 && (
              <ul class="space-y-2">
                {it.includes.slice(0, 5).map((inc: string) => (
                  <li class="flex gap-2 text-sm leading-snug text-ink">
                    <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-highlight" aria-hidden="true"></span>
                    <span>{inc}</span>
                  </li>
                ))}
              </ul>
            )}
            {it.price && <p class="mt-4 font-heading text-lg font-semibold text-brand lg:text-xl">{it.price}</p>}
            <p class="mt-4">
              <a href={it.href || "#contact"} class="inline-flex min-h-11 items-center font-semibold text-brand underline-offset-4 hover:underline">
                {it.href ? `More on ${it.title}` : `Get a quote for ${midSentence(it.title)}`} <span class="ml-2" aria-hidden="true">→</span>
              </a>
            </p>
          </div>
      )}
    </div>
  ))}
</div>

<style>
  .svc-scroll { display: flex; flex-direction: column; gap: 3rem; }

  .svc-scroll-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: center;
  }

  .svc-scroll-ord {
    margin: 0;
    font-family: var(--font-display, inherit);
    font-size: var(--text-eyebrow);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-accent-ink);
  }

  .svc-scroll-media {
    overflow: hidden;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-border);
  }
  /* Text row aside: a ruled column on desktop, a top rule on mobile. */
  .svc-scroll-aside {
    border-top: 1px solid var(--color-border);
    padding-top: 1.25rem;
  }

  .svc-scroll-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  @media (min-width: 64rem) {
    .svc-scroll { gap: 4.5rem; }
    .svc-scroll-row { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 3.5rem; }
    /* Media moves to column 1 on odd rows; text always keeps source order on
       mobile because this only applies at the two-column breakpoint. */
    .svc-scroll-row--flip .svc-scroll-text { order: 2; }
    .svc-scroll-row--flip .svc-scroll-media { order: 1; }
    .svc-scroll-row--text { align-items: start; }
    .svc-scroll-aside {
      border-top: 0;
      padding-top: 0.25rem;
      border-left: 1px solid var(--color-border);
      padding-left: 3.5rem;
    }
  }
</style>
