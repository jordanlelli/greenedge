---
/**
 * ServicesFeatureLead — one large service card with imagery, the rest stacked
 * beside it in a single bordered group.
 *
 * Asymmetric by design, and commercially honest: most trades have one service
 * that pays the bills and several that fill gaps. A uniform grid presents five
 * equal offers, which is a layout ignoring the business.
 *
 * The lead comes from `services.items[].featured` — first true wins, otherwise
 * item[0]. Set it in client-intake.json, never inferred from ordering alone
 * beyond that fallback.
 */
interface Props { items: any[]; leadIndex: number; }
const { items, leadIndex } = Astro.props;

const lead = items[leadIndex];
const rest = items.filter((_: any, i: number) => i !== leadIndex);
---

<div class="svc-feature">
  <article class="svc-feature-lead">
    {lead.image && (
      <div class="svc-feature-media">
        <img src={lead.image} alt={lead.imageAlt} loading="lazy" decoding="async" width="800" height="500" />
      </div>
    )}
    <div class="svc-feature-body">
      <h3 class="font-heading text-2xl font-semibold leading-tight text-brand">
        {lead.href ? (
          <a href={lead.href} class="underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2">{lead.title}</a>
        ) : lead.title}
      </h3>
      {lead.description && (
        <p class="mt-3 text-base leading-relaxed text-muted">{lead.description}</p>
      )}
      {lead.longDescription && (
        <p class="mt-3 text-base leading-relaxed text-muted">{lead.longDescription}</p>
      )}
      {lead.includes.length > 0 && (
        <ul class="mt-4 grid gap-2 sm:grid-cols-2">
          {lead.includes.slice(0, 6).map((inc: string) => (
            <li class="flex gap-2 text-sm leading-snug text-ink">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-highlight" aria-hidden="true"></span>
              <span>{inc}</span>
            </li>
          ))}
        </ul>
      )}
      {lead.price && (
        <p class="mt-4 font-heading text-lg font-semibold text-brand">{lead.price}</p>
      )}
    </div>
  </article>

  <div class="svc-feature-side">
    {rest.map((it: any) => (
      <article class="svc-feature-item">
        <h3 class="font-heading text-base font-semibold leading-snug text-brand">
          {it.href ? (
            <a href={it.href} class="underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2">{it.title}</a>
          ) : it.title}
        </h3>
        {it.description && (
          <p class="mt-1.5 text-sm leading-relaxed text-muted">{it.description}</p>
        )}
        {it.price && (
          <p class="mt-2 font-heading text-sm font-semibold text-brand">{it.price}</p>
        )}
      </article>
    ))}
  </div>
</div>

<style>
  .svc-feature {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .svc-feature-lead {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-card);
    border: 1px solid color-mix(in srgb, var(--color-brand) 20%, transparent);
    background: var(--color-card);
  }
  .svc-feature-media img {
    display: block;
    width: 100%;
    object-fit: cover;
    aspect-ratio: 16 / 10;
  }
  .svc-feature-body { padding: 1.75rem; }

  .svc-feature-side {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-card);
    border: 1px solid color-mix(in srgb, var(--color-brand) 20%, transparent);
    background: var(--color-card);
  }
  .svc-feature-item {
    padding: 1.125rem 1.375rem;
    border-bottom: 1px solid var(--color-border);
  }
  .svc-feature-item:last-child { border-bottom: 0; }

  @media (min-width: 64rem) {
    .svc-feature { grid-template-columns: 1.35fr 1fr; gap: 1.375rem; }
  }
</style>
