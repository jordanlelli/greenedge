---
import { site, formatPhone, legalLinks, headerNavLinks, builtPages } from "../config";
// @ts-ignore - plain-JS content normaliser shared with the Node check scripts
import { resolveServicesPage } from "../lib/content.mjs";
import { services as serviceRecords } from "../data/services";
// @ts-ignore - plain-JS credit resolver shared with the Node check scripts
import { resolveCredit } from "../lib/credit.mjs";

const footer = site.footer || {};
const business = site.business || {};
const contact = site.contact || {};
const name = business.name || "";
const tagline = footer.tagline || business.shortDescription || "";
/* LINK COLUMNS. footer.columns is still the author's call and wins whenever it
   is filled. Left empty — which is how every pipeline-built intake arrives —
   the footer used to be one narrow block of contact details on the left and a
   blank dark slab across the other two thirds of the page. The columns are now
   DERIVED from what the build already knows: the services the intake lists and
   the pages and sections this site actually ships. Nothing is invented; a
   site with no services and no nav still gets no columns. To change a label
   or the links, fill footer.columns: it replaces both. */
const authored: any[] = Array.isArray(footer.columns) ? footer.columns.filter((c: any) => c && (c.links || []).length) : [];
const servicesBuilt = builtPages().includes("services");
/* Same resolver as the /services page, so a footer link can never point at an
   anchor that page did not render. */
const serviceLinks = resolveServicesPage(site, serviceRecords).items
  .filter((it: any) => it.title)
  .slice(0, 6)
  .map((it: any) => ({
    label: it.title,
    href: servicesBuilt ? `/services#${it.anchor}` : "/#services",
  }));
const navLinks = headerNavLinks().map((l) => ({ label: l.label, href: l.href }));
const derived: any[] = [
  serviceLinks.length > 1 && { heading: "Services", links: serviceLinks },
  navLinks.length > 1 && { heading: "On this site", links: navLinks },
].filter(Boolean);
const columns: any[] = authored.length > 0 ? authored : derived;
const year = new Date().getFullYear();
const abn = business.abn || "";
const credit = resolveCredit(site);

/* Social links. contact.instagram / facebook / tiktok have been in the intake
   since the start with no reader, so a client's Instagram went nowhere. For a
   trade, Instagram is often the only place their work photos live, which makes
   it the one outbound link on the page worth having. */
const socials = [
  { label: "Instagram", href: (contact as any).instagram, d: "M12 2.2c3.2 0 3.6 0 4.9.07 1.2.05 1.8.25 2.2.42.6.2 1 .5 1.4 1 .5.4.8.8 1 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c0 1.2-.2 1.8-.4 2.2-.2.6-.5 1-1 1.4-.4.5-.8.8-1.4 1-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2 0-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-1-.5-.4-.8-.8-1-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c0-1.2.2-1.8.4-2.2.2-.6.5-1 1-1.4.4-.5.8-.8 1.4-1 .4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 3.2a6.6 6.6 0 100 13.2 6.6 6.6 0 000-13.2zm0 10.9a4.3 4.3 0 110-8.6 4.3 4.3 0 010 8.6zm8.4-11.2a1.55 1.55 0 11-3.1 0 1.55 1.55 0 013.1 0z" },
  { label: "Facebook", href: (contact as any).facebook, d: "M22 12a10 10 0 10-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.3v7A10 10 0 0022 12z" },
  { label: "TikTok", href: (contact as any).tiktok, d: "M16.6 5.8a4.8 4.8 0 01-1-2.8h-3v12.3a2.4 2.4 0 11-2.4-2.4c.2 0 .4 0 .6.1v-3a5.6 5.6 0 00-.6 0 5.5 5.5 0 105.5 5.5V9.4a7.9 7.9 0 004.5 1.4V7.9a4.7 4.7 0 01-3.6-2.1z" },
].filter((l) => Boolean(l.href));
const copyrightSuffix = footer.copyrightSuffix || "All rights reserved.";
---

{/* Footer text uses the DERIVED on-dark tokens rather than raw opacity.
    text-ondark/60 and /45 were fixed percentages picked to look right against
    one client's brand-dark; on a lighter brand-dark they land near 3:1 and fail
    AA. --c-ondark-soft is fitted per client (see palette.mjs) so it stays as
    quiet as it can while remaining readable on any palette. */}
<footer class="border-t border-transparent bg-brand-dark pb-8 pt-14 text-[var(--c-ondark-soft)] lg:pt-16">
  {/* Same container as the header and every section, so the footer shares the
      site's left AND right edges. Business info holds the left edge; the link
      columns are pushed to the right edge as one group. The bottom bar repeats
      the split: copyright left, legal + credit right. */}
  <div class="mx-auto max-w-[var(--w-content)] px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between lg:gap-16">
      <div class="max-w-sm">
        <span class="font-heading text-lg font-bold text-ondark lg:text-xl">{name}</span>
        {tagline && <p class="mt-3 text-sm leading-relaxed">{tagline}</p>}
        {(contact.phone || contact.email || contact.address) && (
          <ul class="mt-5 space-y-1.5 text-sm">
            {contact.phone && (
              <li><a href={`tel:${formatPhone(contact.phone)}`} class="tap-target inline-flex items-center font-semibold text-ondark transition hover:opacity-80">{contact.phone}</a></li>
            )}
            {contact.email && (
              <li><a href={`mailto:${contact.email}`} class="tap-target inline-flex items-center break-all transition hover:text-ondark">{contact.email}</a></li>
            )}
            {contact.address && <li>{contact.address}</li>}
          </ul>
        )}
        {socials.length > 0 && (
          <ul class="mt-6 flex items-center gap-3">
            {socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  rel="noopener noreferrer"
                  target="_blank"
                  aria-label={s.label}
                  class="flex h-10 w-10 items-center justify-center rounded-full border border-ondark/20 text-[var(--c-ondark-soft)] transition hover:border-ondark/50 hover:text-ondark"
                >
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.d}></path></svg>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

      {columns.length > 0 && (
        <div class="grid grid-cols-2 gap-x-10 gap-y-10 sm:flex sm:gap-x-16 lg:mt-1 lg:gap-x-20">
          {columns.map((col: any) => (
            <div class="min-w-0">
              <p class="text-sm font-bold text-ondark" role="presentation">{col.heading}</p>
              <ul class="mt-4 space-y-2.5 text-sm">
                {(col.links || []).map((l: any) => (
                  <li>
                    <a href={l.href} class="tap-target inline-flex items-center transition hover:text-ondark">{l.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )}
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-ondark/10 pt-6 text-xs sm:flex-row sm:items-center sm:justify-between sm:gap-6">
      <p>
        © {year} {name}. {copyrightSuffix}
        {abn && <> ABN {abn}.</>}
      </p>
      {(legalLinks.length > 0 || credit) && (
        <div class="flex flex-wrap items-center gap-x-5 gap-y-1">
          {legalLinks.map((l) => (
            <a href={l.href} class="tap-target inline-flex items-center text-[var(--c-ondark-soft)] underline-offset-2 transition hover:text-ondark hover:underline">{l.label}</a>
          ))}
          {credit && (
            <span class="text-[var(--c-ondark-soft)]">
              {credit.prefix}{" "}
              <a
                href={credit.url}
                rel={credit.rel || undefined}
                class="font-medium text-ondark/80 underline-offset-2 transition hover:text-ondark hover:underline"
              >{credit.name}</a>{credit.suffix}
            </span>
          )}
        </div>
      )}
    </div>
  </div>
</footer>
