---
/**
 * HeroSplit — copy left, photo bleeding off the right edge.
 * The original composition, preserved. Requires a real photo; Hero.astro will
 * not route here without one.
 */
import HeroCopy from "./HeroCopy.astro";
import { site } from "../../config";

const h = site.hero || {};
---

<section class="bg-bg" data-no-reveal>
  <div class="lg:grid lg:grid-cols-2 lg:items-stretch">
    <div class="order-2 flex flex-col justify-center px-4 py-10 sm:px-6 sm:py-14 lg:order-1 lg:py-20 lg:pl-[max(1rem,calc((100vw-var(--w-wide))/2+2rem))] lg:pr-10">
      <div class="max-w-xl">
        <HeroCopy />
      </div>
    </div>

    <div class="relative order-1 h-[40vh] max-h-[40vh] w-full overflow-hidden bg-[var(--c-brand-900)] lg:order-2 lg:h-auto lg:max-h-none lg:min-h-[28rem]">
      <img
        src={h.image}
        alt={h.imageAlt || site.business?.name || ""}
        width="1600"
        height="2000"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover"
      />
    </div>
  </div>
</section>
