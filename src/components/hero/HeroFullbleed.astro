---
/**
 * HeroFullbleed — photo behind, copy over it.
 *
 * The composition both landscape references use, and the one that needs the
 * most care: text over a photograph fails contrast the moment the photo is
 * bright. The scrim is therefore not optional and not a taste decision — it is
 * a two-stop gradient in the client's own brand-dark, heavy enough that the
 * on-dark tokens hold whatever the photo does. Requires a real photo.
 */
import HeroCopy from "./HeroCopy.astro";
import { site } from "../../config";
import Img from "../Img.astro";

const h = site.hero || {};
/* v3.25 PINNED HERO, on by default: the hero holds its place and the section
   below slides up over it. `hero.cover: false` in the intake turns it off.
   The rules live in global.css (.hero-cover); the script below only measures. */
const cover = site.hero?.cover !== false;
---

<section class:list={["relative isolate overflow-hidden bg-[var(--c-brand-900)]", cover && "hero-cover"]} data-no-reveal>
  <Img sizes="100vw"
    src={h.image}
    alt={h.imageAlt || site.business?.name || ""}
    width="2400"
    height="1600"
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 -z-10 h-full w-full object-cover"
  />
  <div
    class="absolute inset-0 -z-10"
    aria-hidden="true"
    style="background-image: linear-gradient(to right, var(--c-brand-dark) 0%, color-mix(in srgb, var(--c-brand-dark) 82%, transparent) 46%, color-mix(in srgb, var(--c-brand-dark) 30%, transparent) 100%);"
  >
  </div>

  <div class="mx-auto max-w-[var(--w-content)] px-4 pb-16 pt-12 sm:px-6 sm:pb-24 sm:pt-20 lg:px-8 lg:pb-24 lg:pt-16">
    <div class="max-w-[48rem]">
      <HeroCopy tone="ondark" size="large" />
    </div>
  </div>
</section>

<script>
  /* Where the pinned hero sticks. Under the header when the hero fits the
     screen; when it is taller (long copy on a phone) the value goes negative
     so the hero scrolls until its last line is on screen, then holds. */
  (() => {
    const hero = document.querySelector<HTMLElement>(".hero-cover");
    if (!hero) return;
    const header = document.querySelector<HTMLElement>("header");
    const set = () => {
      const headerH = header ? header.offsetHeight : 0;
      const top = Math.min(headerH, window.innerHeight - hero.offsetHeight);
      hero.style.setProperty("--hero-pin-top", top + "px");
    };
    set();
    window.addEventListener("resize", set, { passive: true });
    window.addEventListener("load", set, { once: true });

    /* Once the content below covers it, the hero goes transparent. It stays
       pinned behind the WHOLE page, so anything later that is not fully
       opaque showed it: every section's scroll-in (faded, and 12px short of
       the section above while it rises) and translucent hairlines such as
       the contact divider. Opacity, not visibility, so its h1 stays in the
       accessibility tree. Not sticky (reduced motion, motion "off"): the
       next block never reaches the hero's top, so this never fires. */
    let next = hero.nextElementSibling as HTMLElement | null;
    while (next && (next.offsetHeight === 0 || getComputedStyle(next).position === "fixed")) {
      next = next.nextElementSibling as HTMLElement | null;
    }
    if (!next) return;
    let raf = 0;
    const check = () => {
      raf = 0;
      const covered = next.getBoundingClientRect().top <= hero.getBoundingClientRect().top + 1;
      hero.style.opacity = covered ? "0" : "";
    };
    window.addEventListener("scroll", () => { if (!raf) raf = requestAnimationFrame(check); }, { passive: true });
    window.addEventListener("resize", check, { passive: true });
    check();
  })();
</script>
