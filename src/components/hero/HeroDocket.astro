---
/**
 * HeroDocket — copy left, a ruled spec panel right. No photography, no motif.
 *
 * The bones come from a job docket rather than from web design, which is the
 * point: it does not read as a template because the template corpus does not
 * contain it. It also answers, above the fold and without a single image, the
 * five things a homeowner actually scans for.
 *
 * EVERY ROW IS SOURCED. Nothing here is generated, inferred or rounded. A row
 * with no value in the intake is omitted, never rendered empty and never filled
 * with "Contact us" to keep the panel tidy — a row that says nothing is worse
 * than a row that is not there. The rows come from resolveDocketRows
 * (content.mjs), shared with the engine. Since v3.34 the variant needs
 * DOCKET_MIN_ROWS (4) of them: Hero.astro falls back to another hero when
 * there are fewer, because a three-row panel beside the hero heading leaves
 * the right column mostly empty. The two-row floor below stays as the last
 * line of defence for a hand-forced render.
 */
import HeroCopy from "./HeroCopy.astro";
import { site } from "../../config";
import { resolveDocketRows } from "../../lib/content.mjs";

const rows: { label: string; value: string }[] = resolveDocketRows(site);

const showPanel = rows.length >= 2;
---

<section class="relative overflow-hidden bg-bg" data-no-reveal>
  <div
    class:list={[
      "mx-auto grid max-w-[var(--w-content)] gap-10 px-4 py-14 sm:px-6 sm:py-20 lg:gap-0 lg:px-8 lg:py-24",
      showPanel && "lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)]",
    ]}
  >
    <div class:list={["min-w-0", showPanel && "lg:pr-14"]}>
      <HeroCopy size={showPanel ? "default" : "large"} />
    </div>

    {showPanel && (
      <div class="min-w-0 lg:flex lg:flex-col lg:justify-center lg:border-l lg:border-border lg:pl-14">
        <dl class="hero-docket">
          {rows.map((row) => (
            <div class="hero-docket-row">
              <dt class="hero-docket-key">{row.label}</dt>
              <dd class="hero-docket-val">{row.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    )}
  </div>
</section>

<style>
  .hero-docket { margin: 0; border-top: 1px solid var(--color-border); }

  .hero-docket-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  /* Desktop (v3.34): the rows sit centred against the copy, with the divider
     still running the full height, and take a little more room, so four rows
     beside a four-line heading do not leave the right column half empty. */
  @media (min-width: 64rem) {
    .hero-docket-row { padding: 1.2rem 0; }
  }

  .hero-docket-key {
    margin: 0;
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .hero-docket-val {
    margin: 0;
    min-width: 0;
    font-weight: 600;
    line-height: 1.45;
    color: var(--color-brand);
    text-align: left;
  }

  @media (min-width: 40rem) {
    .hero-docket-val { text-align: right; }
  }
</style>
