---
/** Tick list of a service's inclusions. `cols` splits into two at sm+. */
interface Props { items: string[]; cols?: boolean; class?: string; }
const { items = [], cols = false, class: extra = "" } = Astro.props;
---
{items.length > 0 && (
  <ul class:list={["grid gap-x-6 gap-y-1.5", cols && "sm:grid-cols-2", extra]}>
    {items.map((inc) => (
      <li class="flex min-w-0 items-start gap-2 text-[0.9375rem] leading-snug text-ink">
        <svg class="mt-[0.2em] h-4 w-4 shrink-0 text-highlight" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 111.4-1.4l3.8 3.8 6.8-6.8a1 1 0 011.4 0z" clip-rule="evenodd"></path>
        </svg>
        <span class="min-w-0">{inc}</span>
      </li>
    ))}
  </ul>
)}
