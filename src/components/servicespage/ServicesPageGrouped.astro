---
/**
 * servicesPage/grouped — services organised under intake-defined groups.
 *
 * Needs services.groups[] + items[].group. Each group: a sticky rail on the
 * left (number, H2 group heading, intro, one photo, a quote button) and a
 * two-column card grid on the right. Jump chips at the top link to each
 * group. Group headings are the page's H2s, so write them as keywords
 * ("Excavation and civil works"), not labels ("Other stuff").
 *
 * Without groups it degrades to a single three-column card grid rather than
 * inventing a category. Ungrouped items always render last, unlabelled.
 */
import ServiceIncludes from "./ServiceIncludes.astro";
import ServiceMore from "./ServiceMore.astro";
import Img from "../Img.astro";
interface Props { model: any; }
const { model } = Astro.props;
const groups = model.groups;
const plural = (n: number) => `${n} service${n === 1 ? "" : "s"}`;
---
<section class="bg-bg pb-12 lg:pb-16">
  {groups.length > 0 && (
    <div class="mx-auto max-w-[var(--w-content)] px-4 sm:px-6 lg:px-8">
      <nav aria-label="Service groups" class="-mx-4 overflow-x-auto px-4 pb-2 sm:mx-0 sm:px-0">
        <ul class="flex w-max gap-2.5 sm:w-auto sm:flex-wrap">
          {groups.map((g: any) => (
            <li>
              <a href={`#${g.id}`} class="inline-flex min-h-11 py-2 items-center gap-2 whitespace-nowrap rounded-full border border-border bg-card px-4 text-sm font-bold text-brand transition hover:border-brand/40">
                {g.heading}<span class="font-semibold text-muted">{g.items.length}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  )}

  {groups.map((g: any, gi: number) => (
    <div id={g.id} class="mx-auto mt-12 max-w-[var(--w-content)] scroll-mt-24 px-4 sm:px-6 lg:mt-16 lg:px-8">
      <div class="grid gap-8 border-t border-border pt-12 lg:grid-cols-[minmax(0,21rem)_minmax(0,1fr)] lg:gap-14 lg:pt-16">
        <div class="min-w-0 lg:sticky lg:top-24 lg:self-start">
          <p class="section-eyebrow text-brand-secondary-ink">{String(gi + 1).padStart(2, "0")} · {plural(g.items.length)}</p>
          <h2 class="mt-3 font-heading text-3xl leading-[1.1] tracking-tight text-brand sm:text-4xl">{g.heading}</h2>
          {g.intro && <p class="mt-3 text-base leading-relaxed text-muted lg:text-[1.0625rem]">{g.intro}</p>}
          {g.image && (
            <div class="relative mt-6 hidden aspect-[4/3] overflow-hidden rounded-card border border-border bg-tint sm:block">
              <Img sizes="(min-width: 1024px) 40vw, 100vw" src={g.image} alt={g.imageAlt} width="960" height="720" loading="lazy" decoding="async" class="h-full w-full object-cover" />
            </div>
          )}
          <a href="/#contact" class="mt-6 hidden min-h-11 py-2 items-center justify-center rounded-card bg-accent px-6 font-heading text-[0.9375rem] font-bold tracking-tight text-on-accent transition hover:brightness-95 lg:inline-flex">
            Get a quote
          </a>
        </div>
        <div class="grid min-w-0 content-start gap-4 sm:grid-cols-2">
          {g.items.map((s: any, i: number) => (
            <article id={s.anchor} class:list={["flex min-w-0 scroll-mt-24 flex-col rounded-card border border-border bg-card p-5 sm:p-6", g.items.length % 2 === 1 && i === g.items.length - 1 && "sm:col-span-2"]}>
              <h3 class="font-heading text-xl leading-snug text-brand lg:text-[1.375rem]">{s.title}</h3>
              {s.description && <p class="mt-2 text-[0.9375rem] leading-relaxed text-muted">{s.description}</p>}
              <ServiceIncludes items={s.includes} cols={g.items.length % 2 === 1 && i === g.items.length - 1} class="mt-4" />
              <ServiceMore title={s.title} body={s.longDescription !== s.description ? s.longDescription : ""} price={s.price} />
            </article>
          ))}
        </div>
      </div>
    </div>
  ))}

  {model.ungrouped.length > 0 && (
    <div class:list={["mx-auto max-w-[var(--w-content)] px-4 sm:px-6 lg:px-8", groups.length > 0 && "mt-12 lg:mt-16"]}>
      <div class:list={["grid gap-4 sm:grid-cols-2 lg:grid-cols-3", groups.length > 0 && "border-t border-border pt-12 lg:pt-16"]}>
        {model.ungrouped.map((s: any) => (
          <article id={s.anchor} class="flex min-w-0 scroll-mt-24 flex-col rounded-card border border-border bg-card p-5 sm:p-6">
            <h2 class="font-heading text-xl leading-snug text-brand lg:text-[1.375rem]">{s.title}</h2>
            {s.description && <p class="mt-2 text-[0.9375rem] leading-relaxed text-muted">{s.description}</p>}
            <ServiceIncludes items={s.includes} class="mt-4" />
            <ServiceMore title={s.title} body={s.longDescription !== s.description ? s.longDescription : ""} price={s.price} />
          </article>
        ))}
      </div>
    </div>
  )}
</section>
