---
/**
 * servicesPage/index — a searchable index: service list left, one service in
 * full on the right (desktop); a grouped accordion below 1024px.
 *
 * Best at 10+ services, especially when people arrive looking for ONE job
 * ("UST removal", "core drilling"). Every service is in the HTML in full —
 * the panel only changes which one is visible — so crawlers read all of it.
 *
 * DEEP LINKS. /services#<anchor> opens that service: selected in the panel
 * on desktop, expanded in the accordion on mobile. Use them in Google Ads,
 * GBP posts and SMS replies.
 *
 * NO-JS. Without JavaScript nothing is hidden: every service renders in full
 * and the side list is a set of jump links. The `is-js` class on the root is
 * what switches the interactive behaviour on.
 *
 * HEADINGS. With groups: group = H2, service = H3. Without: service = H2.
 * On desktop the active service's group H2 shows above it as the eyebrow, so
 * the group keyword stays a real, visible heading.
 */
// @ts-ignore — plain-JS helper shared with the Node check scripts
import { midSentence } from "../../lib/content.mjs";
import ServiceIncludes from "./ServiceIncludes.astro";
import { site, formatPhone } from "../../config";
import Img from "../Img.astro";
interface Props { model: any; }
const { model } = Astro.props;
const phone = site.contact?.phone || "";

/* Sections to render: each group, then the ungrouped remainder (unlabelled). */
const blocks = [
  ...model.groups.map((g: any) => ({ id: g.id, heading: g.heading, items: g.items })),
  ...(model.ungrouped.length ? [{ id: "", heading: "", items: model.ungrouped }] : []),
];
const grouped = model.groups.length > 0;
const ST = grouped ? "h3" : "h2";
---
<section class="bg-bg pb-12 lg:pb-16">
  <div class="svc-index mx-auto max-w-[var(--w-content)] px-4 sm:px-6 lg:grid lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] lg:gap-12 lg:px-8 xl:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] xl:gap-16" data-svc-index>
    {/* Desktop index. Hidden below lg, where the accordion IS the index. */}
    <nav aria-label="All services" class="hidden lg:block">
      <div class="sticky top-24 rounded-card border border-border bg-card p-2">
        {blocks.map((b: any) => (
          <div class="py-1">
            {b.heading && <p class="px-3 pb-1 pt-2.5 text-sm font-semibold leading-snug text-muted">{b.heading}</p>}
            <ul>
              {b.items.map((s: any) => (
                <li>
                  <a href={`#${s.anchor}`} data-svc-link={s.anchor} class="svc-link block rounded-card px-3 py-1.5 text-[0.9375rem] font-medium leading-snug text-ink transition hover:bg-tint hover:text-brand">
                    {s.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </nav>

    <div class="min-w-0">
      {blocks.map((b: any) => (
        <div class="svc-group mb-8 last:mb-0 lg:mb-0" data-svc-group>
          {b.heading && (
            <h2 class="svc-group-h mb-1 font-heading text-2xl leading-tight tracking-tight text-brand sm:text-3xl lg:mb-3 lg:font-body lg:text-[0.8125rem] lg:font-bold lg:uppercase lg:leading-none lg:tracking-[0.16em] lg:text-brand-secondary-ink">
              {b.heading}
            </h2>
          )}
          <div class="border-t border-border lg:border-0">
            {b.items.map((s: any) => (
              <article id={s.anchor} class="svc-item scroll-mt-24 border-b border-border lg:border-0" data-svc-item>
                <ST class="m-0 font-heading text-brand">
                  {/* v3.22: titles over 50 characters wrap to two or three lines at 40px; they step down to 34px with 1.3 leading so the block reads as a heading, not a slab. */}
                  <button type="button" class:list={["svc-toggle flex min-h-14 w-full items-center justify-between gap-4 py-3 text-left text-lg leading-snug tracking-tight lg:pointer-events-none lg:min-h-0 lg:cursor-default lg:py-0", s.title.length > 50 ? "lg:text-[2.125rem] lg:leading-[1.3]" : "lg:text-[2.5rem] lg:leading-[1.1]"]} aria-expanded="true" data-svc-toggle>
                    <span class="min-w-0">{s.title}</span>
                    <svg class="svc-chevron h-5 w-5 shrink-0 text-brand transition-transform lg:hidden" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.3 7.3a1 1 0 011.4 0L10 10.6l3.3-3.3a1 1 0 111.4 1.4l-4 4a1 1 0 01-1.4 0l-4-4a1 1 0 010-1.4z" clip-rule="evenodd"></path></svg>
                  </button>
                </ST>
                <div class="svc-body pb-7 lg:pb-0">
                  {s.image && (
                    <div class="relative mb-5 mt-1 aspect-[16/9] overflow-hidden rounded-card border border-border bg-tint lg:mb-1 lg:mt-6 lg:aspect-[2/1]">
                      <Img sizes="(min-width: 1024px) 800px, 100vw" src={s.image} alt={s.imageAlt} width="1200" height="675" loading="lazy" decoding="async" class="h-full w-full object-cover" />
                    </div>
                  )}
                  {s.description && <p class:list={["text-lg leading-relaxed text-ink lg:text-xl", s.image ? "lg:mt-5" : "lg:mt-4"]}>{s.description}</p>}
                  {s.longDescription && s.longDescription !== s.description && (
                    <p class="mt-4 text-base leading-relaxed text-muted lg:text-[1.0625rem]">{s.longDescription}</p>
                  )}
                  {s.includes.length > 0 && (
                    <div class="mt-6 rounded-card border border-border bg-card p-5 sm:p-6">
                      <p class="text-[0.75rem] font-bold uppercase tracking-[0.14em] text-muted">What's included</p>
                      <ServiceIncludes items={s.includes} cols class="mt-3" />
                    </div>
                  )}
                  {s.price && <p class="mt-5 text-sm font-bold uppercase tracking-wide text-brand-secondary-ink">{s.price}</p>}
                  <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
                    <a href="/#contact" class="inline-flex min-h-[3.25rem] py-3 items-center justify-center rounded-card bg-accent px-7 font-heading text-base font-bold tracking-tight text-on-accent transition hover:brightness-95">
                      Get a quote for {midSentence(s.title)}
                    </a>
                    {phone && (
                      <a href={`tel:${formatPhone(phone)}`} class="inline-flex min-h-11 items-center justify-center font-heading text-base font-bold tracking-tight text-brand underline-offset-4 hover:underline sm:px-3">
                        or call {phone}
                      </a>
                    )}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Mobile accordion (below lg). Only once JS has run — no-JS shows all. */
  .svc-index.is-js .svc-item:not(.is-open) .svc-body { display: none; }
  .svc-index.is-js .svc-item.is-open .svc-chevron { transform: rotate(180deg); }
  .svc-index:not(.is-js) .svc-chevron { display: none; }

  @media (min-width: 64rem) {
    /* Desktop panel: one service visible, its group heading as eyebrow. */
    .svc-index.is-js .svc-item { display: none; }
    .svc-index.is-js .svc-item.is-active { display: flex; flex-direction: column; }
    /* .is-active matches the mobile :not(.is-open) rule's specificity; being
       later in the file it wins, so the active panel is never collapsed. */
    .svc-index.is-js .svc-item.is-active .svc-body { display: flex; flex-direction: column; }
    .svc-index.is-js .svc-group { display: none; }
    .svc-index.is-js .svc-group.is-active { display: block; }
    .svc-index:not(.is-js) .svc-item { padding-bottom: 3rem; margin-bottom: 3rem; border-bottom: 1px solid var(--color-border); }
    .svc-index .svc-link[aria-current="true"] {
      background: var(--color-tint);
      color: var(--color-brand);
      font-weight: 700;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-svc-index]");
  if (root) {
    const items = Array.from(root.querySelectorAll<HTMLElement>("[data-svc-item]"));
    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>("[data-svc-link]"));
    const desk = window.matchMedia("(min-width: 64rem)");
    const byId = (id: string) => items.find((el) => el.id === id);

    const setOpen = (el: HTMLElement, open: boolean) => {
      el.classList.toggle("is-open", open);
      el.querySelector("[data-svc-toggle]")?.setAttribute("aria-expanded", String(open));
    };
    const setActive = (el: HTMLElement) => {
      for (const it of items) it.classList.toggle("is-active", it === el);
      for (const g of root.querySelectorAll<HTMLElement>("[data-svc-group]")) g.classList.toggle("is-active", g.contains(el));
      for (const a of links) a.setAttribute("aria-current", String(a.dataset.svcLink === el.id));
    };
    const fromHash = () => byId(decodeURIComponent(location.hash.slice(1)));

    /* v3.21 — every panel but the active one is display:none, and a lazy
       image inside display:none is never fetched, so each photo used to start
       downloading on the click that revealed it. Layout.astro now fetches
       every lazy image once the page is idle; this covers the first second or
       two before that, by starting the one image about to be shown on hover,
       focus or touch — 100-300ms before the click lands. */
    const warm = (el?: HTMLElement) => {
      el?.querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((img) => { img.loading = "eager"; });
    };

    root.classList.add("is-js");
    for (const it of items) setOpen(it, false);
    const start = fromHash() || items[0];
    if (start) {
      setActive(start);
      if (fromHash()) setOpen(start, true);
    }

    for (const it of items) {
      const toggle = it.querySelector("[data-svc-toggle]");
      for (const ev of ["pointerenter", "focus", "touchstart"]) toggle?.addEventListener(ev, () => warm(it), { once: true, passive: true });
      toggle?.addEventListener("click", () => {
        if (desk.matches) return;
        setOpen(it, !it.classList.contains("is-open"));
      });
    }
    for (const a of links) {
      for (const ev of ["pointerenter", "focus"]) a.addEventListener(ev, () => warm(byId(a.dataset.svcLink || "")), { once: true, passive: true });
      a.addEventListener("click", (e) => {
        const el = byId(a.dataset.svcLink || "");
        if (!el) return;
        e.preventDefault();
        setActive(el);
        setOpen(el, true);
        history.replaceState(null, "", `#${el.id}`);
        const top = root.getBoundingClientRect().top;
        if (top < 0) root.scrollIntoView({ block: "start" });
      });
    }
    window.addEventListener("hashchange", () => {
      const el = fromHash();
      if (el) { setActive(el); setOpen(el, true); }
    });
  }
</script>
