---
import { site, formatPhone } from "../config";
// @ts-ignore - plain-JS field resolver shared with the privacy page and check scripts
import { resolveFormFields } from "../lib/content.mjs";
import Section from "./Section.astro";

const cs = site.contactSection || {};
const contact = site.contact || {};
const form = cs.form || { enabled: true, fields: ["name", "email", "phone", "message"] };
/* Resolved centrally so the privacy page's collection list and the form itself
   can never disagree — see resolveFormFields in src/lib/content.mjs. */
const fields: string[] = resolveFormFields(site);
const showField = (name: string) => fields.includes(name);
const heading = cs.heading || "Get a free quote";
const eyebrow = cs.eyebrow || "";
const subhead = cs.subhead || "";
const businessName = site.business?.name || "";
const emailSubject = cs.emailSubject || (businessName ? `New enquiry — ${businessName}` : "New website enquiry");
const messagePlaceholder = cs.messagePlaceholder || "Tell us what needs doing.";
const hasFaq = Array.isArray(site.faqs?.items) && site.faqs.items.length > 0;

const phone = contact.phone || "";
const email = contact.email || "";
const enquiryTypes: string[] = contact.enquiryTypes || [];
const endpoint = (contact.formEndpoint || "").trim();
const formEnabled = form.enabled !== false;
const formUsable = formEnabled && !!endpoint;
---

<Section id="contact" bg="bg">
  <div>
    <div class="max-w-2xl">
      {eyebrow && (
        <p class="section-eyebrow text-[0.6875rem] font-semibold uppercase leading-[1.4] tracking-[0.14em] text-brand-secondary-ink">{eyebrow}</p>
      )}
      <h2 class:list={["section-heading font-heading text-3xl font-semibold tracking-tight text-brand sm:text-4xl", eyebrow && "mt-2"]}>{heading}</h2>
      {subhead && <p class="mt-3 text-lg leading-relaxed text-muted">{subhead}</p>}
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-5">
      <div class="lg:col-span-3">
        {formUsable ? (
          <>
            <form
              action={endpoint}
              method="POST"
              class="space-y-5 rounded-card border border-border bg-card p-6 shadow-sm sm:p-8"
              data-contact-form
              data-phone={phone || ""}
            >
              <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
              <input type="hidden" name="_captcha" value="false" />
              <input type="hidden" name="_subject" value={emailSubject} />
              <input type="hidden" name="_template" value="table" />

              <div class="grid gap-5 sm:grid-cols-2">
                <div>
                  <label for="name" class="mb-1.5 block text-sm font-medium text-ink">Name</label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    autocomplete="name"
                    class="w-full rounded-lg border border-border px-4 py-3 text-sm focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20"
                  />
                </div>
                {showField("phone") && (
                <div>
                  <label for="phone" class="mb-1.5 block text-sm font-medium text-ink">Phone</label>
                  <input
                    type="tel"
                    id="phone"
                    name="phone"
                    required
                    inputmode="tel"
                    autocomplete="tel"
                    class="w-full rounded-lg border border-border px-4 py-3 text-sm focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20"
                  />
                </div>
                )}
              </div>

              {showField("email") && (
              <div>
                <label for="email" class="mb-1.5 block text-sm font-medium text-ink">Email</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  autocomplete="email"
                  class="w-full rounded-lg border border-border px-4 py-3 text-sm focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20"
                />
              </div>
              )}

              {showField("suburb") && (
              <div>
                <label for="suburb" class="mb-1.5 block text-sm font-medium text-ink">Suburb</label>
                <input
                  type="text"
                  id="suburb"
                  name="suburb"
                  required
                  autocomplete="address-level2"
                  class="w-full rounded-lg border border-border px-4 py-3 text-sm focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20"
                />
              </div>
              )}

              {showField("enquiryType") && enquiryTypes.length > 0 && (
              <div>
                <label for="enquiryType" class="mb-1.5 block text-sm font-medium text-ink">Enquiry type</label>
                <select
                  id="enquiryType"
                  name="enquiryType"
                  class="w-full rounded-lg border border-border px-4 py-3 text-sm focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20"
                >
                  <option value="">Select…</option>
                  {enquiryTypes.map((t) => <option value={t}>{t}</option>)}
                </select>
              </div>
              )}

              {showField("message") && (
              <div>
                <label for="message" class="mb-1.5 block text-sm font-medium text-ink">What needs doing?</label>
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  placeholder={messagePlaceholder}
                  class="w-full resize-none rounded-lg border border-border px-4 py-3 text-sm focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20"
                ></textarea>
              </div>
              )}

              <p class="hidden text-sm text-red-700" data-form-error role="alert"></p>

              <button
                type="submit"
                class="rounded-card bg-accent px-8 py-3.5 text-sm font-semibold text-on-accent shadow-card transition hover:brightness-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60"
                data-form-submit
              >
                {form.submitLabel || "Send quote request"}
              </button>

              {hasFaq && (
                <p class="text-sm leading-relaxed text-muted">
                  Have a question before you get in touch?
                  {" "}
                  <a href="/faq" class="font-semibold text-brand underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand">
                    See the FAQ
                  </a>
                  .
                </p>
              )}
            </form>

            <div class="mt-4 hidden rounded-card border border-border bg-card p-6 shadow-sm sm:p-8" data-form-success role="status">
              <p class="font-heading text-xl font-semibold text-brand">Thanks. We will be in touch.</p>
              <p class="mt-2 text-sm leading-relaxed text-muted">
                We usually reply within one business day. Prefer faster? Call {phone || "us"}.
              </p>
              <div class="mt-5 flex flex-wrap gap-3">
                {phone && (
                  <a
                    href={`tel:${formatPhone(phone)}`}
                    class="inline-flex min-h-11 items-center rounded-card bg-accent px-6 py-3 text-sm font-semibold text-on-accent transition hover:brightness-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2"
                  >
                    Call {phone}
                  </a>
                )}
                <button
                  type="button"
                  class="inline-flex min-h-11 items-center rounded-card border border-border bg-bg px-6 py-3 text-sm font-semibold text-brand transition hover:border-brand/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2"
                  data-form-again
                >
                  Send another quote request
                </button>
              </div>
            </div>
          </>
        ) : (
          <div class="rounded-card border border-border bg-card p-8 shadow-sm">
            <p class="text-lg font-medium text-brand">Call or email for a free quote.</p>
            <p class="mt-2 text-sm text-muted">Fastest path: a quick call.</p>
          </div>
        )}
      </div>

      <div class="lg:col-span-2">
        <div class="rounded-card border border-border bg-card p-5">
          {phone && (
            <a href={`tel:${formatPhone(phone)}`} class="block rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2">
              <p class="text-sm font-medium text-muted">Prefer to call?</p>
              <p class="mt-1 text-xl font-semibold text-brand">{phone}</p>
            </a>
          )}
          {email && (
            <a href={`mailto:${email}`} class:list={["block rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2", phone && "mt-5 border-t border-border pt-5"]}>
              <p class="text-sm font-medium text-muted">Email</p>
              <p class="mt-1 font-semibold text-brand">{email}</p>
            </a>
          )}
          {contact.address && (
            <div class:list={[ (phone || email) && "mt-5 border-t border-border pt-5"]}>
              <p class="text-sm font-medium text-muted">Based in</p>
              <p class="mt-1 font-medium text-brand">{contact.address}</p>
            </div>
          )}
          {contact.hours && (
            <div class:list={[ (phone || email || contact.address) && "mt-5 border-t border-border pt-5"]}>
              <p class="text-sm font-medium text-muted">Hours</p>
              <p class="mt-1 text-sm text-ink">{contact.hours}</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</Section>

{formUsable && (
  <script>
    (() => {
      const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
      if (!form) return;
      const submitBtn = form.querySelector<HTMLButtonElement>("[data-form-submit]");
      const errEl = form.querySelector<HTMLElement>("[data-form-error]");
      const success = document.querySelector<HTMLElement>("[data-form-success]");
      const againBtn = document.querySelector<HTMLButtonElement>("[data-form-again]");
      const defaultLabel = submitBtn?.textContent || "Send quote request";
      const phoneHint = form.dataset.phone || "";

      againBtn?.addEventListener("click", () => {
        success?.classList.add("hidden");
        form.classList.remove("hidden");
        form.reset();
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = defaultLabel;
        }
      });

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!submitBtn || !errEl || !success) return;
        errEl.classList.add("hidden");
        errEl.textContent = "";
        submitBtn.disabled = true;
        submitBtn.textContent = "Sending…";

        try {
          const res = await fetch(form.action, {
            method: "POST",
            body: new FormData(form),
            headers: { Accept: "application/json" },
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok || data.success === "false" || data.success === false) {
            throw new Error(data.message || "submit_failed");
          }
          form.classList.add("hidden");
          success.classList.remove("hidden");
        } catch {
          errEl.textContent = phoneHint
            ? `Couldn't send the form just now. Check your connection and try again, or call ${phoneHint}.`
            : "Couldn't send the form just now. Check your connection and try again.";
          errEl.classList.remove("hidden");
          submitBtn.disabled = false;
          submitBtn.textContent = defaultLabel;
        }
      });
    })();
  </script>
)}
