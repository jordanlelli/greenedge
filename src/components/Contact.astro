---
import { site, layout, formatPhone } from "../config";

/* True when the engine has already made this whole section the inverted band.
   The details panel then takes the on-band card surface instead of the band
   surface, because dark-on-dark would erase it. */
const bandIsHere = layout?.bandSection === "contact";
// @ts-ignore - plain-JS field resolver shared with the privacy page and check scripts
import { resolveFormFields } from "../lib/content.mjs";
import Section from "./Section.astro";

const cs = site.contactSection || {};
const contact = site.contact || {};
const form = cs.form || { enabled: true, fields: ["name", "email", "phone", "message"] };
/* Resolved centrally so the privacy page's collection list and the form itself
   can never disagree — see resolveFormFields in src/lib/content.mjs. */
const fields: string[] = resolveFormFields(site);
const showField = (name: string) => fields.includes(name);
const heading = cs.heading || "Get a free quote";
const eyebrow = cs.eyebrow || "";
const subhead = cs.subhead || "";
const businessName = site.business?.name || "";
const emailSubject = cs.emailSubject || (businessName ? `New enquiry — ${businessName}` : "New website enquiry");
const messagePlaceholder = cs.messagePlaceholder || "Tell us what needs doing.";
const hasFaq = Array.isArray(site.faqs?.items) && site.faqs.items.length > 0;

const phone = contact.phone || "";
const email = contact.email || "";
const enquiryTypes: string[] = contact.enquiryTypes || [];
const endpoint = (contact.formEndpoint || "").trim();
const formEnabled = form.enabled !== false;
const formUsable = formEnabled && !!endpoint;
/* With no form, the left column leads with the number (and names the email),
   so the panel beside it carries only what is not already said: where the
   business is and when it is open. Printing the number twice, a column apart,
   is the same repetition the hero and header were cleaned of. */
const panelPhone = formUsable && Boolean(phone);
const panelEmail = formUsable && Boolean(email);
const panelHasRows = panelPhone || panelEmail || Boolean(contact.address) || Boolean(contact.hours);
---

{/* PERMANENT SECTION BREAK. The contact block is the last thing on the page
    and the one the whole site is pointing at; without a rule it ran straight
    out of whatever section preceded it. Full-bleed and 2px so it reads as a
    deliberate end-of-page divider rather than as another hairline between
    content blocks — every other rule on the site is 1px, which is what makes
    2px read as different in kind. Uses the border token, so it inverts with
    the section when the engine puts the colour band here. */}
<div class="contact-break" aria-hidden="true"></div>

<Section id="contact" bg="bg">
  <div>
    <div class="max-w-2xl">
      {eyebrow && (
        <p class="section-eyebrow text-brand-secondary-ink">{eyebrow}</p>
      )}
      <h2 class:list={["section-heading font-heading text-3xl font-semibold tracking-tight text-brand sm:text-4xl lg:text-[2.75rem] lg:leading-[1.1]", eyebrow && "mt-2"]}>{heading}</h2>
      {subhead && <p class="mt-3 text-lg leading-relaxed text-muted">{subhead}</p>}
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-5">
      <div class="contact-col min-w-0 lg:col-span-3" data-reveal-from="left">
        {formUsable ? (
          <>
            <form
              action={endpoint}
              method="POST"
              class="space-y-5"
              data-contact-form
              data-phone={phone || ""}
            >
              <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
              <input type="hidden" name="_captcha" value="false" />
              <input type="hidden" name="_subject" value={emailSubject} />
              <input type="hidden" name="_template" value="table" />

              <div class="grid gap-5 sm:grid-cols-2">
                <div>
                  <label for="name" class="mb-1.5 block text-sm font-medium text-ink">Name</label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    autocomplete="name"
                    class="w-full rounded-input border border-ink/55 bg-card px-4 py-3 text-base text-ink focus:border-brand"
                  />
                </div>
                {showField("phone") && (
                <div>
                  <label for="phone" class="mb-1.5 block text-sm font-medium text-ink">Phone</label>
                  <input
                    type="tel"
                    id="phone"
                    name="phone"
                    required
                    inputmode="tel"
                    autocomplete="tel"
                    class="w-full rounded-input border border-ink/55 bg-card px-4 py-3 text-base text-ink focus:border-brand"
                  />
                </div>
                )}

              {/* Short fields share the two-column grid. Email and suburb each
                  took a full row, which made the form ~180px taller than the
                  details panel beside it (check-layout column-gap). */}
              {showField("email") && (
              <div>
                <label for="email" class="mb-1.5 block text-sm font-medium text-ink">Email</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  autocomplete="email"
                  class="w-full rounded-input border border-ink/55 bg-card px-4 py-3 text-base text-ink focus:border-brand"
                />
              </div>
              )}

              {showField("suburb") && (
              <div>
                <label for="suburb" class="mb-1.5 block text-sm font-medium text-ink">Suburb</label>
                <input
                  type="text"
                  id="suburb"
                  name="suburb"
                  required
                  autocomplete="address-level2"
                  class="w-full rounded-input border border-ink/55 bg-card px-4 py-3 text-base text-ink focus:border-brand"
                />
              </div>
              )}
              </div>

              {showField("enquiryType") && enquiryTypes.length > 0 && (
              <div>
                <label for="enquiryType" class="mb-1.5 block text-sm font-medium text-ink">Enquiry type</label>
                <select
                  id="enquiryType"
                  name="enquiryType"
                  class="w-full rounded-input border border-ink/55 bg-card px-4 py-3 text-base text-ink focus:border-brand"
                >
                  <option value="">Select…</option>
                  {enquiryTypes.map((t) => <option value={t}>{t}</option>)}
                </select>
              </div>
              )}

              {showField("message") && (
              <div>
                <label for="message" class="mb-1.5 block text-sm font-medium text-ink">What needs doing?</label>
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  placeholder={messagePlaceholder}
                  class="w-full resize-none rounded-input border border-ink/55 bg-card px-4 py-3 text-base text-ink focus:border-brand"
                ></textarea>
              </div>
              )}

              <p class="hidden text-sm text-red-700" data-form-error role="alert"></p>

              <button
                type="submit"
                class="rounded-card bg-accent px-8 py-3.5 text-sm font-semibold text-on-accent shadow-card transition hover:brightness-95 disabled:cursor-not-allowed disabled:opacity-60"
                data-form-submit
              >
                {form.submitLabel || "Send quote request"}
              </button>

              {hasFaq && (
                <p class="text-sm leading-relaxed text-muted">
                  Have a question before you get in touch?
                  {" "}
                  <a href="/faq" class="font-semibold text-brand underline-offset-4 hover:underline">
                    See the FAQ
                  </a>
                  .
                </p>
              )}
            </form>

            <div class="mt-4 hidden rounded-card border border-border bg-card p-6 shadow-sm sm:p-8" data-form-success role="status">
              <p class="font-heading text-xl font-semibold text-brand lg:text-2xl">Thanks. We will be in touch.</p>
              <p class="mt-2 text-sm leading-relaxed text-muted">
                We usually reply within one business day. Prefer faster? Call {phone || "us"}.
              </p>
              <div class="mt-5 flex flex-wrap gap-3">
                {phone && (
                  <a
                    href={`tel:${formatPhone(phone)}`}
                    class="inline-flex min-h-11 items-center rounded-card bg-accent px-6 py-3 text-sm font-semibold text-on-accent transition hover:brightness-95"
                  >
                    Call {phone}
                  </a>
                )}
                <button
                  type="button"
                  class="inline-flex min-h-11 items-center rounded-card border border-border bg-bg px-6 py-3 text-sm font-semibold text-brand transition hover:border-brand/30"
                  data-form-again
                >
                  Send another quote request
                </button>
              </div>
            </div>
          </>
        ) : (
          <div class="contact-direct">
            {phone ? (
              <a href={`tel:${formatPhone(phone)}`} class="contact-direct-number hero-display font-heading text-brand underline-offset-8 hover:underline">{phone}</a>
            ) : email ? (
              <a href={`mailto:${email}`} class="font-heading text-2xl font-semibold text-brand underline underline-offset-4 lg:text-3xl">{email}</a>
            ) : null}
            <p class="mt-5 text-lg leading-relaxed text-muted">
              {phone ? "Call for a free quote." : "Email for a free quote."}
              {phone && email && <> Or email <a href={`mailto:${email}`} class="font-semibold text-brand underline underline-offset-4">{email}</a>.</>}
            </p>
          </div>
        )}
      </div>

      <div class="contact-col min-w-0 lg:col-span-2" data-reveal-from="right">
        {/* DARK PANEL. The details beside the form are reference, not input,
            and giving them the band surface separates the two jobs at a glance
            instead of running two near-identical white cards side by side.
            `contact-panel--onband` is the fallback for when the engine has
            already made this whole section the colour band: dark-on-dark would
            lose the panel entirely, so there it takes the on-band card surface
            instead. */}
        {panelHasRows && (
        <div class:list={["contact-panel rounded-card p-6", bandIsHere && "contact-panel--onband"]}>
          {panelPhone && (
            <a href={`tel:${formatPhone(phone)}`} class="block">
              <p class="text-sm font-medium text-muted">Prefer to call?</p>
              <p class="mt-1 text-xl font-semibold text-brand">{phone}</p>
            </a>
          )}
          {panelEmail && (
            <a href={`mailto:${email}`} class:list={["block", panelPhone && "contact-rule mt-5 pt-5"]}>
              <p class="text-sm font-medium text-muted">Email</p>
              <p class="mt-1 font-semibold text-brand">{email}</p>
            </a>
          )}
          {contact.address && (
            <div class:list={[ (panelPhone || panelEmail) && "contact-rule mt-5 pt-5"]}>
              <p class="text-sm font-medium text-muted">Based in</p>
              <p class="mt-1 font-medium text-brand">{contact.address}</p>
            </div>
          )}
          {contact.hours && (
            <div class:list={[ (panelPhone || panelEmail || contact.address) && "contact-rule mt-5 pt-5"]}>
              <p class="text-sm font-medium text-muted">Hours</p>
              <p class="mt-1 text-sm text-ink">{contact.hours}</p>
            </div>
          )}
        </div>
        )}
      </div>
    </div>
  </div>
</Section>

{formUsable && (
  <script>
    (() => {
      const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
      if (!form) return;
      const submitBtn = form.querySelector<HTMLButtonElement>("[data-form-submit]");
      const errEl = form.querySelector<HTMLElement>("[data-form-error]");
      const success = document.querySelector<HTMLElement>("[data-form-success]");
      const againBtn = document.querySelector<HTMLButtonElement>("[data-form-again]");
      const defaultLabel = submitBtn?.textContent || "Send quote request";
      const phoneHint = form.dataset.phone || "";

      againBtn?.addEventListener("click", () => {
        success?.classList.add("hidden");
        form.classList.remove("hidden");
        form.reset();
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = defaultLabel;
        }
      });

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!submitBtn || !errEl || !success) return;
        errEl.classList.add("hidden");
        errEl.textContent = "";
        submitBtn.disabled = true;
        submitBtn.textContent = "Sending…";

        try {
          const res = await fetch(form.action, {
            method: "POST",
            body: new FormData(form),
            headers: { Accept: "application/json" },
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok || data.success === "false" || data.success === false) {
            throw new Error(data.message || "submit_failed");
          }
          form.classList.add("hidden");
          success.classList.remove("hidden");
        } catch {
          errEl.textContent = phoneHint
            ? `Couldn't send the form just now. Check your connection and try again, or call ${phoneHint}.`
            : "Couldn't send the form just now. Check your connection and try again.";
          errEl.classList.remove("hidden");
          submitBtn.disabled = false;
          submitBtn.textContent = defaultLabel;
        }
      });
    })();
  </script>
)}

<style>
  /* Overflow floor (v3.17). A grid item's min-width defaults to `auto`, which
     resolves to its MIN-CONTENT width — so one unbreakable string (a long
     client email such as jobs@northpointplumbing.com.au, or a phone number
     that will not wrap) sets the track's minimum and pushes the whole column
     past the gutter. Measured at 360px: the column rendered 348px wide inside
     a 328px container and ran 4px off the viewport. body carries
     overflow-x-clip so no scrollbar appeared and the content was simply cut.
     min-w-0 on the grid children lets the track shrink; this lets the text
     inside it wrap rather than just clip. */
  .contact-col :is(p, a, dd, li, span) {
    overflow-wrap: anywhere;
  }

  /* Permanent end-of-page divider. 2px against the 1px used everywhere else,
     so it reads as a different kind of rule rather than as one more hairline. */
  .contact-break {
    height: 2px;
    width: 100%;
    background: var(--color-border);
  }

  /* Reference, not input: the band surface separates the details panel from
     the form rather than running two white cards beside each other. */
  .contact-panel {
    background: var(--c-band, var(--color-brand));
    color: var(--c-on-band, var(--color-ondark));
    border: 1px solid transparent;
  }

  .contact-panel :is(p, a, dt, dd, span) { color: inherit; }
  /* The rule is a border on a square block. It used to sit on a rounded <a>,
     so each divider curled up at both ends. */
  .contact-panel .contact-rule { border-top: 1px solid var(--c-on-band-rule, var(--color-border)); }
  .contact-panel--onband .contact-rule { border-top-color: var(--color-border); }

  /* No form: the phone number at display size is the call to action. */
  .contact-direct-number {
    display: inline-block;
    font-size: clamp(2.25rem, 1.4rem + 4vw, 4.5rem);
  }

  /* Already inverted by the engine — take the on-band card surface so the
     panel is still visible against its own section. */
  .contact-panel--onband {
    background: var(--c-on-band-card, var(--color-card));
    color: var(--color-ink);
    border-color: var(--color-border);
  }
</style>