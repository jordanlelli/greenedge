---
/**
 * Story — about + service areas in one cream section, then a numbered
 * process strip. Replaces the old thin Story / Usage pair on the homepage.
 * Usage.astro remains for /areas (full suburb list).
 */
import { site, variantOf } from "../config";
import Section from "./Section.astro";

const story = site.story || {};

const heading = story.heading || "About us";
const eyebrow = story.eyebrow || "";
/* cards[].badges renders a chip list instead of body text — clients use it for
   "Interior & exterior", "Fully insured", that sort of thing. It had no reader,
   so those cards rendered with an empty body. */
const cards = (story.cards || []).map((c: any) => ({
  ...c,
  badges: Array.isArray(c?.badges) ? c.badges.filter(Boolean) : [],
}));
const body = story.body || "";
const paragraphs = body.split(/\n\n+/).filter(Boolean).slice(0, 3);

/* SUPPRESSION: whyUs/process-rail renders numbered steps on a rail. Printing
   this strip as well puts two numbered sequences on one page, which reads as a
   mistake rather than as rhythm — the same reason whyUs and its neighbours are
   excluded from the colour band. whyUs wins because it is the more prominent
   placement and is gated on the content actually being a process. */
const whyUsIsProcessRail =
  !Array.isArray(site.whyUs) && site.whyUs?.type === "process" &&
  variantOf("whyUs", "ruled-rows") === "process-rail";
const processSteps: { title: string; body: string }[] =
  whyUsIsProcessRail ? [] : story.process || [];

const ordinal = (i: number) => String(i + 1).padStart(2, "0");
---

<Section id="story" bg="bg" pad="tight" class="story-areas">
  <div class="max-w-2xl">
    {eyebrow && (
      <p class="section-eyebrow text-[0.6875rem] font-semibold uppercase leading-[1.4] tracking-[0.14em] text-brand-secondary-ink">{eyebrow}</p>
    )}
    <h2 class:list={["section-heading font-heading text-3xl font-semibold tracking-tight text-brand sm:text-4xl", eyebrow && "mt-2"]}>
      {heading}
    </h2>
  </div>

  {cards.length > 0 && (
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {cards.map((card: any) => (
        <li class="rounded-card border border-border bg-card p-5">
          {card.title && <p class="font-heading font-semibold text-brand">{card.title}</p>}
          {card.description && <p class="mt-2 text-sm leading-relaxed text-muted">{card.description}</p>}
          {card.badges.length > 0 && (
            <ul class="mt-3 flex flex-wrap gap-2">
              {card.badges.map((b: string) => (
                <li class="rounded-full border border-border px-2.5 py-1 text-xs font-medium text-muted">{b}</li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  )}

  <div class="mt-8 max-w-[70ch] space-y-4 text-base leading-relaxed text-muted">
    {paragraphs.map((p: string) => <p class="text-pretty">{p}</p>)}
  </div>

  {processSteps.length > 0 && (
    <ol class="story-process mt-12" aria-label="How a job runs">
      {processSteps.map((step, i) => (
        <li class="story-process-step">
          <span class="story-process-num" aria-hidden="true">{ordinal(i)}</span>
          <h3 class="story-process-title">{step.title}</h3>
          <p class="story-process-body">{step.body}</p>
        </li>
      ))}
    </ol>
  )}
</Section>

<style>
  /* Process strip: numerals + connecting hairline */
  .story-process {
    display: grid;
    gap: 1.75rem;
    margin: 0;
    padding: 1.75rem 0 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
    counter-reset: none;
  }

  @media (min-width: 64rem) {
    .story-process {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0;
    }
  }

  .story-process-step {
    position: relative;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 64rem) {
    .story-process-step {
      padding: 0 1.25rem;
    }

    .story-process-step:first-child {
      padding-left: 0;
    }

    .story-process-step:last-child {
      padding-right: 0;
    }

    /* Connecting hairline through the numeral row */
    .story-process-step:not(:last-child)::after {
      content: "";
      position: absolute;
      top: 0.55rem;
      left: calc(2.25rem);
      right: 0;
      height: 1px;
      background: var(--color-border);
    }
  }

  .story-process-num {
    position: relative;
    z-index: 1;
    display: inline-block;
    margin-bottom: 0.625rem;
    padding-right: 0.5rem;
    background: var(--color-bg);
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.08em;
    color: var(--color-accent-ink);
  }

  .story-process-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--color-brand);
  }

  .story-process-body {
    margin: 0.375rem 0 0;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-muted);
  }
</style>
