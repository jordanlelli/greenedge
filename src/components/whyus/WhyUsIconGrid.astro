---
/**
 * WhyUsIconGrid — tick cards on the dark band. The safe fallback: works with
 * any number of points, needs no extra intake shape.
 *
 * Column count follows the same principle as the services grid — pick a shape
 * the item count actually fills, rather than leaving a hole at the end of the
 * last row. Unlike services there is no CTA card here, so a prime count simply
 * uses a column count that divides it.
 */
interface Props { items: { title: string; description: string }[]; }
const { items } = Astro.props;

const n = items.length;
const cols = n <= 2 ? n : n === 3 ? 3 : n === 4 ? 2 : n === 5 ? 5 : n === 6 ? 3 : n === 7 ? 4 : 4;
---

<ul class="why-grid" style={`--why-cols:${cols}`}>
  {items.map((it) => (
    <li class="why-grid-item">
      <span class="why-grid-tick" aria-hidden="true">
        <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 111.4-1.4l3.8 3.8 6.8-6.8a1 1 0 011.4 0z" clip-rule="evenodd"></path></svg>
      </span>
      <p class="why-grid-title">{it.title}</p>
      <p class="why-grid-desc">{it.description}</p>
    </li>
  ))}
</ul>

<style>
  .why-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .why-grid-item {
    padding: 1.5rem 1.375rem;
    border: 1px solid var(--c-ondark-rule);
    border-radius: var(--radius-card);
  }

  .why-grid-tick {
    display: flex;
    height: 1.875rem;
    width: 1.875rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid var(--c-ondark-rule);
    color: var(--color-accent-ondark);
    margin-bottom: 0.875rem;
  }
  .why-grid-tick svg { height: 0.875rem; width: 0.875rem; }

  .why-grid-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-ondark);
  }

  .why-grid-desc {
    margin: 0.5rem 0 0;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--c-ondark-soft);
  }

  @media (min-width: 40rem) { .why-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .why-grid { grid-template-columns: repeat(var(--why-cols), minmax(0, 1fr)); } }
</style>
