---
/**
 * WhyUsRuledRows — hairline-divided rows, title left / description right.
 *
 * This is the pre-v3.16 WhyUs layout with ONE change: the ordinals are gone.
 * They implied a sequence the content does not have. "Fixed written quotes",
 * "engineer-spec mesh" and "site left clean" are reorderable without losing
 * meaning, which is the test — numbering them asserted an order that was never
 * true and would have been read as steps.
 *
 * Numbering lives in process-rail, which is gated on whyUs.type === "process",
 * i.e. on content that actually is a sequence.
 */
interface Props { items: { title: string; description: string }[]; }
const { items } = Astro.props;
---

<dl class="why-us-list">
  {items.map((it) => (
    <div class="why-us-row">
      <dt class="why-us-term">
        <span class="why-us-label">{it.title}</span>
      </dt>
      <dd class="why-us-desc">{it.description}</dd>
    </div>
  ))}
</dl>

<style>
  .why-us-list { margin: 0; }

  .why-us-row {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--c-ondark-rule);
  }
  .why-us-row:last-child { border-bottom: none; padding-bottom: 0; }

  .why-us-term { display: flex; align-items: baseline; gap: 0.75rem; margin: 0; }

  .why-us-label {
    font-family: var(--font-heading);
    font-size: var(--text-lead);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--color-ondark);
  }

  .why-us-desc {
    margin: 0;
    max-width: 40em;
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: 1.7;
    color: var(--c-ondark-soft);
  }

  @media (min-width: 40rem) {
    .why-us-row {
      grid-template-columns: minmax(14rem, 18rem) minmax(0, 40em);
      gap: 2rem;
      align-items: start;
      justify-content: start;
    }
  }
</style>
