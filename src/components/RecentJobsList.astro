---
import { Image } from "astro:assets";
import type { RecentJob } from "../lib/types";
import { galleryServiceNames } from "../data/gallery";

interface Props {
  jobs: RecentJob[];
}

const { jobs } = Astro.props;
---

<ul class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-6 lg:gap-y-8">
  {jobs.map((job) => (
    <li class="min-w-0">
      {job.photo && (
        <div class="overflow-hidden rounded-card border border-border bg-card">
          <Image
            src={job.photo}
            alt={job.photoAlt || ""}
            widths={[400, 640]}
            sizes="(min-width: 1024px) 22rem, (min-width: 640px) 45vw, 100vw"
            class="aspect-[4/3] h-auto w-full object-cover"
          />
        </div>
      )}
      <h3 class="mt-4 font-heading text-lg font-semibold tracking-tight text-balance text-brand lg:text-xl">
        {job.suburb}
      </h3>
      <p class="mt-1 text-[0.6875rem] font-semibold leading-[1.4] text-brand">
        <span class="uppercase tracking-[0.14em]">{galleryServiceNames[job.service]}</span>
        <span class="text-muted"> · </span>
        <span class="font-medium normal-case tracking-normal text-muted">{job.month}</span>
      </p>
      <p class="mt-2 text-sm leading-snug text-muted sm:text-base sm:leading-relaxed">
        {job.oneLine}
      </p>
    </li>
  ))}
</ul>
