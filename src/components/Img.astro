---
/**
 * Img — drop-in for <img> on any intake-supplied image path (v3.21).
 *
 * Same attributes as a plain <img>. When the path exists under src/assets/
 * (see src/lib/images.ts) it renders through astro:assets with a responsive
 * srcset, so a phone downloads a 480-800px WebP instead of the full upload.
 * Otherwise it renders the plain <img> it always did. Extra attributes
 * (onerror fallbacks, data-*) pass straight through in both cases.
 *
 * `sizes` is the one prop that matters: it tells the browser how wide the
 * image is on screen so it can pick the right file. Give each call site a
 * real value; "100vw" (the default) is only right for full-bleed images.
 */
import { Image } from "astro:assets";
import { localImage, widthsFor } from "../lib/images";

interface Props {
  src: string;
  alt: string;
  sizes?: string;
  widths?: number[];
  quality?: number;
  [key: string]: any;
}

const { src, alt, sizes = "100vw", widths, quality = 72, width, height, ...rest } = Astro.props;
const meta = localImage(src);
---
{meta ? (
  <Image src={meta} alt={alt} widths={widthsFor(meta, widths)} sizes={sizes} quality={quality} format="webp" {...rest} />
) : (
  <img src={src} alt={alt} width={width} height={height} {...rest} />
)}
