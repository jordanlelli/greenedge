---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../config";
// @ts-ignore — plain-JS page gate shared with the Node check scripts
import { pageIsBuilt } from "../lib/pages.mjs";

const faqs = site.faqs || {};
const items: any[] = faqs.items || [];
const eyebrow = faqs.eyebrow || "FAQ";
const heading = faqs.heading || "Common questions";
const title = `FAQ | ${site.business?.name || ""}`;

/* An empty page is worse than no page: a 200 with nothing on it is a soft
   404 to a crawler and a dead end to a visitor. If there is no content,
   send them somewhere that has some. */
if (!pageIsBuilt("faq", site)) return Astro.redirect("/#faqs");
---

<Layout title={title} description={site.seo?.description} pageType="other">
  <Header />
  <section class="bg-bg sec-pad-default">
    <div class="mx-auto max-w-6xl px-4 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <span class="text-sm font-semibold uppercase tracking-wide text-highlight">{eyebrow}</span>
        <h1 class="mt-2 font-heading text-3xl font-semibold tracking-tight text-brand sm:text-4xl">{heading}</h1>
      </div>

      <div class="mx-auto mt-12 max-w-3xl divide-y divide-brand/10 border-t border-border">
        {items.map((f: any) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-heading text-lg font-semibold text-brand marker:content-none [&::-webkit-details-marker]:hidden">
              <span>{f.question}</span>
              <svg class="h-5 w-5 shrink-0 text-accent-ink transition group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <p class="mt-3 text-base leading-relaxed text-muted">{f.answer}</p>
          </details>
        ))}
      </div>

      <div class="mt-12 text-center">
        <a
          href="/#contact"
          class="inline-flex items-center justify-center rounded-card bg-accent px-7 py-3.5 text-sm font-semibold text-on-accent transition hover:bg-accent/90"
        >
          Get a free quote
        </a>
      </div>
    </div>
  </section>
  <Footer />
</Layout>
