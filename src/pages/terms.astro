---
/**
 * Terms of service (website terms of use) — renders only when
 * legal.terms.enabled. Trade-agnostic, plain-language, config-driven. This
 * covers USE OF THE WEBSITE; it is not the client's service/works contract
 * (that's a separate document). Standard boilerplate, NOT legal advice — have
 * the client review and adjust before relying on it. Fill legal.terms in
 * client-intake.json (a TODO on a live legal page is a critical defect — B7).
 */
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Section from "../components/Section.astro";
import { site } from "../config";
// @ts-ignore - clause composer
import { resolveTerms } from "../lib/terms.mjs";
// @ts-ignore - the same gate the footer uses
import { legalPageState } from "../lib/legal.mjs";

const terms = site.legal?.terms || {};
/* One gate, shared with the footer — see src/lib/legal.mjs. Publishing a
   policy with "[SET legal.terms.entityName]" in the body is worse than not
   publishing one, so a page missing its required facts redirects instead. */
if (!legalPageState("terms", site).live) return Astro.redirect("/");

const field = (key: string, value: unknown): string => {
  if (value == null || value === "" || value === "TODO") return `TODO — ${key}`;
  return String(value);
};

const entityName = field("entityName", terms.entityName || site.business?.name);
const lastUpdated = field("lastUpdated", terms.lastUpdated);
const contactEmail = terms.contactEmail || site.contact?.email || "";
const abn = terms.abn || site.business?.abn || "";
const governingState = terms.governingState || "South Australia";
const country = terms.country || "Australia";

const title = `Terms of service — ${site.business?.name || entityName}`;
const description = `The terms that apply when you use the ${entityName} website.`;

/* Clauses are composed in src/lib/terms.mjs. Every terms-of-trade clause is
   gated on a fact the client supplied: a deposit percentage or a warranty period
   we invented is a term their customers could hold them to. */
const { website, commerce, trade, hasTradeTerms } = resolveTerms(site);

/* Section groups, rendered by one loop. The old page hand-wrote a "General"
   block with Australian Consumer Law and liability paragraphs inline — the
   same ground the commerce clauses now cover from the resolver, so keeping
   both would have published the same point twice in different words. */
const groups = [
  { id: "website-terms", heading: "Website terms", intro: "", clauses: website },
  { id: "general-terms", heading: "General terms", intro: "", clauses: commerce },
  ...(hasTradeTerms
    ? [{ id: "trade-terms", heading: "Terms of trade",
         intro: "These terms apply to work we quote and carry out. Where a written quote says something different and specific, the quote applies on that point.",
         clauses: trade }]
    : []),
];
---

<Layout title={title} description={description} pageType="other" robots="noindex,follow">
  <Header />
  <main>
    <Section id="terms" bg="bg">
      <div class="legal-doc max-w-3xl">
        <h1 class="font-heading text-3xl font-semibold tracking-tight text-brand sm:text-4xl">Terms of service</h1>
        <p class="mt-3 text-muted">Last updated: {lastUpdated}</p>
      </div>

      <div class="legal-doc mt-10 max-w-3xl">
        <p>
          These terms apply to your use of the {entityName}{abn && <> (ABN {abn})</>} website
          {hasTradeTerms && <>, and to work we carry out for you</>}. By using this site you
          accept the website terms below. If you do not accept them, please do not use the site.
        </p>

        <nav class="legal-toc" aria-label="On this page">
          <p class="legal-toc-label">On this page</p>
          <ol class="legal-toc-list">
            {groups.flatMap((g: any) => g.clauses).map((c: any) => (
              <li><a class="tap-target legal-toc-link" href={`#${c.id}`}>{c.heading}</a></li>
            ))}
          </ol>
        </nav>

        {groups.map((g: any) => (
          <section class="legal-group" id={g.id}>
            <h2 class="legal-group-heading">{g.heading}</h2>
            {g.intro && <p class="legal-para">{g.intro}</p>}
            {g.clauses.map((clause: any) => (
              <section id={clause.id} class="legal-section">
                <h3 class="legal-heading">{clause.heading}</h3>
                <p class="legal-para">{clause.body}</p>
              </section>
            ))}
          </section>
        ))}

      </div>
    </Section>
  </main>
  <Footer />
</Layout>

<style>
  /* Shared with /privacy. A legal page is read rather than scanned, so it gets
     a tighter measure and more air between clauses than a marketing section. */
  .legal-doc :is(h1, h2, h3, p, li, a) { overflow-wrap: anywhere; }

  .legal-toc {
    padding: 1.25rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .legal-toc-label {
    margin: 0 0 0.75rem;
    font-family: var(--font-body);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .legal-toc-list { display: grid; gap: 0.125rem; margin: 0; padding: 0; list-style: none; }

  @media (min-width: 40rem) {
    .legal-toc-list { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2rem; }
  }

  .legal-toc-link {
    display: flex; align-items: center; min-height: 2.25rem;
    font-family: var(--font-body); font-size: var(--text-small); line-height: 1.4;
    color: var(--color-brand); text-decoration: none; text-underline-offset: 4px;
  }

  .legal-toc-link:hover { text-decoration: underline; }

  .legal-group { margin-top: 3rem; }

  .legal-group-heading {
    margin: 0 0 1.25rem; padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-heading); font-size: var(--text-title); font-weight: 600;
    line-height: 1.25; color: var(--color-brand);
  }

  .legal-section { margin-top: 2rem; scroll-margin-top: 6rem; }

  .legal-heading {
    margin: 0 0 0.75rem;
    font-family: var(--font-heading); font-size: var(--text-lead);
    font-weight: 600; line-height: 1.3; color: var(--color-brand);
  }

  .legal-para {
    margin: 0 0 0.875rem; max-width: 38em;
    font-family: var(--font-body); font-size: var(--text-body);
    line-height: 1.7; color: var(--color-ink);
  }

  .legal-para:last-child { margin-bottom: 0; }
</style>
