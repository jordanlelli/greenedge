---
/**
 * Service detail, from one of two sources:
 *  - src/data/services.ts records (rich: process, exclusions, photos), or
 *  - when that file is empty, intake services.items[] that set `slug`
 *    (resolveServiceDetailPages in content.mjs), with their before/after
 *    sliders from beforeAfter.items[].service.
 * Images via astro:assets. The only client JS is the slider's.
 */
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import GalleryEntries from "../../components/GalleryEntries.astro";
import BeforeAfter from "../../components/BeforeAfter.astro";
import ServicesPageHead from "../../components/servicespage/ServicesPageHead.astro";
import ServiceIncludes from "../../components/servicespage/ServiceIncludes.astro";
import ServicesQuoteBand from "../../components/servicespage/ServicesQuoteBand.astro";
import { site, formatPhone } from "../../config";
import { services } from "../../data/services";
import { galleryEntries } from "../../data/gallery";
import { recentJobs } from "../../data/recent-jobs";
import { getServiceBySlug, formatServicePrice, getGalleryByService } from "../../lib/data";
import type { GalleryService } from "../../lib/types";
// @ts-ignore — plain-JS helpers shared with the Node check scripts
import { resolveServiceDetailPages, resolveServicesPage, midSentence } from "../../lib/content.mjs";
// @ts-ignore
import { pageIsBuilt } from "../../lib/pages.mjs";

export function getStaticPaths() {
  const fromIntake = resolveServiceDetailPages(site, services).map((p: any) => ({ params: { slug: p.slug } }));
  return [...services.map((service) => ({ params: { slug: service.slug } })), ...fromIntake];
}

const { slug } = Astro.params;
const service = getServiceBySlug(slug || "");
const detail: any = service ? null : resolveServiceDetailPages(site, services).find((p: any) => p.slug === slug);

if (!service && !detail) {
  throw new Error(`Unknown service slug: ${slug}`);
}

const phone = site.contact?.phone || "";
const businessName = site.business?.name || "";
const title = service ? `${service.name} | ${businessName}` : detail.seoTitle || `${detail.heading} | ${businessName}`;
const description = service ? service.shortLine : detail.seoDescription || detail.shortLine;
const [hero, ...serviceImages] = service?.images || [];
const longDescriptionParagraphs = (service?.longDescription || detail?.longDescription || "").split(/\n\n+/).filter(Boolean);
const workEntries = service ? getGalleryByService(service.slug as GalleryService) : [];
/* The note is for placeholder photos only; real work never carries it. */
const workIsPlaceholder = workEntries.some((entry) => entry.isPlaceholder);
const quote = resolveServicesPage(site, services);
const galleryBuilt = pageIsBuilt("gallery", site, { galleryEntries, recentJobs });
---

<Layout title={title} description={description} pageType="services">
  <Header />

  {detail && (
    <main id="main">
      <ServicesPageHead eyebrow="" heading={detail.heading} subhead={detail.shortLine} />

      <section class="bg-bg">
        <div class="mx-auto grid max-w-[var(--w-content)] gap-10 border-t border-border px-4 py-12 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:px-8 lg:py-16">
          <div class="min-w-0">
            {longDescriptionParagraphs.map((paragraph: string) => (
              <p class="mt-4 text-base leading-relaxed text-muted first:mt-0 lg:text-[1.0625rem]">{paragraph}</p>
            ))}
            {detail.price && <p class="mt-6 text-sm font-bold uppercase tracking-wide text-brand-secondary-ink">{detail.price}</p>}
          </div>
          <div class="min-w-0 lg:border-l lg:border-border lg:pl-16">
            {detail.includes.length > 0 && (
              <>
                <p class="text-[0.75rem] font-bold uppercase tracking-[0.14em] text-muted">What's included</p>
                <ServiceIncludes items={detail.includes} class="mt-4" />
              </>
            )}
            <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
              <a href="/#contact" class="inline-flex min-h-[3.25rem] items-center justify-center rounded-card bg-accent px-7 py-3 font-heading text-base font-bold tracking-tight text-on-accent transition hover:brightness-95">Get a quote for {midSentence(detail.name)}</a>
              {phone && (
                <a href={`tel:${formatPhone(phone)}`} class="inline-flex min-h-11 items-center justify-center font-heading text-base font-bold tracking-tight text-brand underline-offset-4 hover:underline sm:px-3">Call {phone}</a>
              )}
            </div>
          </div>
        </div>
      </section>

      <BeforeAfter
        items={detail.beforeAfter}
        heading={detail.beforeAfterHeading || `${detail.name}: before and after`}
        subhead={detail.beforeAfterSubhead}
      />

      {galleryBuilt && (
        <section class="bg-bg">
          <div class="mx-auto max-w-[var(--w-content)] px-4 pb-14 sm:px-6 lg:px-8 lg:pb-20">
            <a href="/gallery" class="inline-flex min-h-11 items-center font-semibold text-brand underline-offset-4 hover:underline">
              See more of our work <span class="ml-2" aria-hidden="true">→</span>
            </a>
          </div>
        </section>
      )}

      <ServicesQuoteBand heading={quote.quoteHeading} body={quote.quoteBody} />
    </main>
  )}

  {service && (<>

  <section class="bg-bg" data-no-reveal>
    <div class="mx-auto max-w-[var(--w-content)] px-4 py-14 sm:px-6 lg:px-8 lg:py-16">
      <p class="text-sm font-semibold text-highlight-ink">
        <a href="/services" class="hover:underline">Services</a>
        {" "}
        <span aria-hidden="true">/</span>
        {" "}
        {service.name}
      </p>
      <h1 class="mt-3 max-w-3xl font-heading text-4xl font-semibold tracking-tight text-brand sm:text-5xl">
        {service.name}
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">{service.shortLine}</p>
    </div>
  </section>

  <section class="sec-pad-default bg-bg">
    <div class="mx-auto grid max-w-[var(--w-content)] gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:px-8">
      <div class="min-w-0">
        {hero && (
          <Image
            src={hero.src}
            alt={hero.alt}
            widths={[480, 720, 960]}
            sizes="(max-width: 1024px) 100vw, 560px"
            width={720}
            height={540}
            loading="eager"
            class="aspect-[4/3] w-full rounded-card border border-border object-cover shadow-card"
          />
        )}
      </div>
      <div class="min-w-0">
        <div class="max-w-2xl space-y-4">
          {longDescriptionParagraphs.map((paragraph) => (
            <p class="text-base leading-relaxed text-muted">{paragraph}</p>
          ))}
        </div>

        <p class="mt-6 font-heading text-2xl font-semibold text-brand">
          {formatServicePrice(service)}
        </p>
        <p class="mt-1 text-sm leading-relaxed text-muted">
          This price is indicative and confirmed on site before work starts.
          {service.priceIsPlaceholder && (
            <>
              {" "}
              <span class="font-medium text-ink">(Rate shown is a placeholder until confirmed.)</span>
            </>
          )}
        </p>
        <p class="mt-2 text-sm text-muted">Typical duration:{" "}{service.typicalDuration}</p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/#contact" class="rounded-card bg-accent px-6 py-3 text-center text-sm font-semibold text-on-accent transition hover:brightness-95">
            Get a free quote
          </a>
          {phone && (
            <a href={`tel:${formatPhone(phone)}`} class="rounded-card border border-brand/20 px-6 py-3 text-center text-sm font-semibold text-brand transition hover:bg-card">
              Call {phone}
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="sec-pad-tight bg-bg">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-3xl font-semibold tracking-tight text-brand">What happens on the day</h2>
      <ol class="mt-6 list-decimal space-y-4 pl-6 marker:font-semibold marker:text-highlight-ink">
        {service.process.map((step) => (
          <li class="pl-2 text-base leading-relaxed text-ink">{step}</li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sec-pad-tight bg-bg">
    <div class="mx-auto grid max-w-[var(--w-content)] gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:px-8">
      <div class="min-w-0">
        <h2 class="font-heading text-2xl font-semibold text-brand">Included</h2>
        <ul class="mt-5 divide-y divide-border border-y border-border">
          {service.inclusions.map((item) => (
            <li class="flex items-start gap-3 py-3.5 text-base leading-relaxed text-ink">
              <svg xmlns="http://www.w3.org/2000/svg" class="mt-1 h-4 w-4 shrink-0 text-highlight" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="min-w-0">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="min-w-0">
        <h2 class="font-heading text-2xl font-semibold text-brand">Not included</h2>
        <ul class="mt-5 divide-y divide-border border-y border-border">
          {service.exclusions.map((item) => (
            <li class="flex items-start gap-3 py-3.5 text-base leading-relaxed text-ink">
              <span class="mt-0.5 shrink-0 font-semibold text-brand" aria-hidden="true">×</span>
              <span class="min-w-0">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="sec-pad-tight bg-card">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl font-semibold text-brand">What to prepare</h2>
      <ul class="mt-5 space-y-3">
        {service.whatCustomerNeedsToPrepare.map((item) => (
          <li class="flex items-start gap-3 text-base leading-relaxed text-ink">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-highlight" aria-hidden="true"></span>
            <span class="min-w-0">{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {workEntries.length > 0 && (
    <section class="sec-pad-default bg-bg">
      <div class="mx-auto max-w-[var(--w-content)] px-4 sm:px-6 lg:px-8">
        <h2 class="font-heading text-3xl font-semibold tracking-tight text-brand">Work gallery</h2>
        {workIsPlaceholder && (
          <p class="mt-3 max-w-2xl text-base leading-relaxed text-muted">
            PLACEHOLDER gallery. These images are placeholders, not completed work, and must be replaced before launch.
          </p>
        )}
        <div class="mt-8">
          <GalleryEntries entries={workEntries} variant="full" />
        </div>
      </div>
    </section>
  )}

  {serviceImages.length > 0 && (
    <section class="sec-pad-default bg-bg">
      <div class="mx-auto max-w-[var(--w-content)] px-4 sm:px-6 lg:px-8">
        <h2 class="font-heading text-2xl font-semibold text-brand">Photos</h2>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {serviceImages.map((img) => (
            <li>
              <Image
                src={img.src}
                alt={img.alt}
                widths={[320, 480, 720]}
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 360px"
                width={480}
                height={360}
                loading="lazy"
                class="aspect-[4/3] w-full rounded-card border border-border object-cover shadow-card"
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  </>)}

  <Footer />
</Layout>
