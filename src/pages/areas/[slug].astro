---
/**
 * /areas/[slug] — a service-area page.
 *
 * The route Local SEO Foundation sells and could not previously deliver.
 *
 * getStaticPaths only returns suburbs that pass areaPageState, so a thin page
 * is not something you have to remember not to publish — it cannot be built.
 * Suburbs without page-worthy content stay as entries on /areas, which is the
 * honest treatment: they are served, there just isn't a page's worth to say yet.
 */
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Section from "../../components/Section.astro";
import Contact from "../../components/Contact.astro";
import { site, formatPhone } from "../../config";
// @ts-ignore — plain-JS area resolver shared with the Node check scripts
import { buildableAreas, allAreas } from "../../lib/areas.mjs";

/* TIER GATE. Per-suburb pages are a PREMIUM deliverable, not part of a basic
   build. A basic site gets one /areas page listing the coverage; the moment a
   client has a page per suburb they also have the ongoing obligation to keep
   each one genuinely different, which is what the 70%-similarity gate in
   areas.mjs exists to police.
   Default false. Flip features.suburbPages to true to unlock them — the
   existing content gates then still apply on top, so enabling the feature
   does NOT force a thin page into existence. */
export function getStaticPaths() {
  if (site.features?.suburbPages !== true) return [];
  return buildableAreas(site).map((area: any) => ({
    params: { slug: area.slug },
    props: { area },
  }));
}

const { area } = Astro.props as { area: any };
const business = site.business || {};
const phone = site.contact?.phone || "";

/* The trade word is the H1's subject, so a missing business.trade must not
   produce "Trade in Reynella". Fall back through the tagline to a plain, always
   true phrasing. area.heading overrides the lot. */
const tradeWord = String(business.trade || "").trim();
const heading =
  area.heading ||
  (tradeWord ? `${tradeWord} in ${area.name}` : `${business.name || "Our services"} in ${area.name}`);
const title = `${heading} | ${business.name || ""}`;
const description =
  area.metaDescription || `${area.intro}`.split(/(?<=[.!?])\s/).slice(0, 2).join(" ").slice(0, 155);

const paragraphs = String(area.intro || "").split(/\n\n+/).filter(Boolean);
const others = allAreas(site).filter((a: any) => a.slug !== area.slug).slice(0, 12);
---

<Layout title={title} description={description} pageType="area">
  <Header />
  <main>
    <Section bg="bg">
      <div class="max-w-3xl">
        <p class="text-[0.6875rem] font-semibold uppercase leading-[1.4] tracking-[0.14em] text-brand-secondary-ink">
          <a href="/areas" class="hover:underline">Service areas</a>
          <span aria-hidden="true"> / </span>{area.name}
        </p>
        <h1 class="mt-3 font-heading text-4xl font-semibold tracking-tight text-brand sm:text-5xl">
          {heading}
        </h1>
        <div class="mt-6 space-y-4 text-lg leading-relaxed text-ink">
          {paragraphs.map((p: string) => <p>{p}</p>)}
        </div>
        <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-3">
          <a href="#contact" class="inline-flex min-h-11 items-center justify-center rounded-card bg-accent px-7 py-3 text-base font-semibold text-on-accent transition hover:brightness-95">
            Get a free quote in {area.name}
          </a>
          {phone && (
            <a href={`tel:${formatPhone(phone)}`} class="inline-flex min-h-11 items-center font-semibold text-[var(--c-brand-900)] underline-offset-4 hover:underline">
              Call {phone} <span class="ml-2" aria-hidden="true">&#8594;</span>
            </a>
          )}
        </div>
      </div>
    </Section>

    {area.services.length > 0 && (
      <Section bg="tint">
        <div class="max-w-3xl">
          <h2 class="font-heading text-2xl font-semibold text-brand">What we do in {area.name}</h2>
          <ul class="mt-6 grid gap-3 sm:grid-cols-2">
            {area.services.map((s: string) => (
              <li class="flex items-start gap-2 text-base leading-relaxed text-ink">
                <svg class="mt-1 h-4 w-4 shrink-0 text-highlight" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 111.4-1.4l3.8 3.8 6.8-6.8a1 1 0 011.4 0z" clip-rule="evenodd"></path>
                </svg>
                <span>{s}</span>
              </li>
            ))}
          </ul>
        </div>
      </Section>
    )}

    {area.jobs.length > 0 && (
      <Section bg="bg">
        <div class="max-w-3xl">
          <h2 class="font-heading text-2xl font-semibold text-brand">Recent work in {area.name}</h2>
          <ul class="mt-6 space-y-5">
            {area.jobs.map((job: any) => (
              <li class="rounded-card border border-border bg-card p-5">
                {job.title && <p class="font-semibold text-brand">{job.title}</p>}
                {job.street && <p class="mt-1 text-sm text-muted">{job.street}</p>}
                {job.detail && <p class="mt-2 leading-relaxed text-ink">{job.detail}</p>}
              </li>
            ))}
          </ul>
        </div>
      </Section>
    )}

    {area.note && (
      <Section bg="tint">
        <div class="max-w-3xl">
          <h2 class="font-heading text-2xl font-semibold text-brand">Local knowledge</h2>
          <p class="mt-4 text-lg leading-relaxed text-ink">{area.note}</p>
        </div>
      </Section>
    )}

    {/* Attributable only — the same rule the testimonials section holds to. */}
    {area.testimonialQuote && area.testimonialSourceUrl && (
      <Section bg="bg">
        <figure class="max-w-3xl">
          <blockquote class="text-xl leading-relaxed text-ink">&#8220;{area.testimonialQuote}&#8221;</blockquote>
          <figcaption class="mt-4 text-sm text-muted">
            <a href={area.testimonialSourceUrl} rel="noopener noreferrer" target="_blank" class="font-semibold text-brand underline-offset-4 hover:underline">
              {area.testimonialName || "Verified review"}
            </a>
            <span> &#183; {area.name}</span>
          </figcaption>
        </figure>
      </Section>
    )}

    {others.length > 0 && (
      <Section bg="tint">
        <div class="max-w-3xl">
          <h2 class="font-heading text-2xl font-semibold text-brand">Other areas we cover</h2>
          <ul class="mt-5 flex flex-wrap gap-x-4 gap-y-2 text-base text-ink">
            {others.map((a: any) => (
              <li>
                {a.listedOnly ? <span>{a.name}</span> : <a href={`/areas/${a.slug}`} class="text-brand underline-offset-4 hover:underline">{a.name}</a>}
              </li>
            ))}
          </ul>
        </div>
      </Section>
    )}

    <Contact />
  </main>
  <Footer />
</Layout>
