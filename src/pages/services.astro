---
/**
 * /services — the "everything we do" page.
 *
 * LAYOUT is a MANUAL axis: _brief.layoutVariants.servicesPage picks one of
 *   stacked  (default) one service per row — best at 1–6 services
 *   grouped            services under intake-defined groups — needs groups
 *   featured           photo cards for headline services + a catalogue
 *   index              list + detail panel / accordion — best at 10+
 * The seeded engine never picks it; see MANUAL in src/lib/variants.mjs and
 * VARIANT-CHEAT-SHEET.txt §4.
 *
 * CONTENT: rich records in src/data/services.ts win when a client has them;
 * otherwise the page is built from the intake's services.items[]. Every
 * service's full longDescription is in the HTML in every variant — compact
 * layouts put it behind a disclosure, they never drop it.
 */
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ServicesPageHead from "../components/servicespage/ServicesPageHead.astro";
import ServicesPageStacked from "../components/servicespage/ServicesPageStacked.astro";
import ServicesPageGrouped from "../components/servicespage/ServicesPageGrouped.astro";
import ServicesPageFeatured from "../components/servicespage/ServicesPageFeatured.astro";
import ServicesPageIndex from "../components/servicespage/ServicesPageIndex.astro";
import ServicesQuoteBand from "../components/servicespage/ServicesQuoteBand.astro";
import { site, variantOf, pageSeo } from "../config";
import { services as richServices } from "../data/services";
import { formatServicePrice } from "../lib/data";
// @ts-ignore — plain-JS page gate shared with the Node check scripts
import { pageIsBuilt } from "../lib/pages.mjs";
// @ts-ignore — plain-JS normaliser shared with the Node check scripts
import { resolveServicesPage } from "../lib/content.mjs";

/* An empty page is worse than no page: a 200 with nothing on it is a soft
   404 to a crawler and a dead end to a visitor. */
if (!pageIsBuilt("services", site, { serviceRecords: richServices })) return Astro.redirect("/");

const records = richServices.map((s: any) => ({ ...s, priceLabel: formatServicePrice(s) }));
const model = resolveServicesPage(site, records);

const VARIANTS: Record<string, any> = {
  stacked: ServicesPageStacked,
  grouped: ServicesPageGrouped,
  featured: ServicesPageFeatured,
  index: ServicesPageIndex,
};
const variant = variantOf("servicesPage", "stacked");
const Body = VARIANTS[variant] || ServicesPageStacked;

const { title, description } = pageSeo(
  "services",
  `${model.heading} | ${site.business?.name || ""}`,
  model.subhead || site.seo?.description || site.business?.shortDescription || ""
);
---

<Layout title={title} description={description} pageType="services">
  <Header />
  <main id="main">
    <ServicesPageHead eyebrow={model.eyebrow} heading={model.heading} subhead={model.subhead} />
    <Body model={model} />
    <ServicesQuoteBand heading={model.quoteHeading} body={model.quoteBody} />
  </main>
  <Footer />
</Layout>
