---
/**
 * /privacy — renders whatever src/lib/privacy.mjs assembles, and nothing of
 * its own. Every sentence on this page comes from the resolver so the policy
 * is testable in Node without a browser, and so a second implementation cannot
 * drift away from the first.
 *
 * Before v3.17 this page hardcoded about eight paragraphs. It had no overseas
 * disclosure (APP 8), no access-and-correction process (APP 12/13), no
 * complaints path or OAIC escalation, no retention period, and nothing about
 * what a trade business collects off the website — property addresses, site
 * photographs, access details. For a tradie that is most of the personal
 * information they hold.
 *
 * NOT LEGAL ADVICE. It is an accurate, plain-English starting point built from
 * facts the client supplied, for the client to review.
 */
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Section from "../components/Section.astro";
import { site } from "../config";
// @ts-ignore — the same gate the footer uses
import { legalPageState } from "../lib/legal.mjs";
// @ts-ignore — the same field resolver the contact form renders from, so the
// policy can never claim to collect less than the form actually asks for
import { resolveFormFields, FORM_FIELD_LABELS } from "../lib/content.mjs";
// @ts-ignore — plain-JS resolver, shared with the Node check scripts
import { resolvePrivacy } from "../lib/privacy.mjs";

if (!legalPageState("privacy", site).live) return Astro.redirect("/");

const lastUpdated = site.legal?.privacy?.lastUpdated || "";

const formFields = resolveFormFields(site).map(
  (f: string) => FORM_FIELD_LABELS[f as keyof typeof FORM_FIELD_LABELS] || f
);

const policy = resolvePrivacy(site, { formFields });

const title = `Privacy policy — ${site.business?.name || policy.entity}`;
const description = `How ${policy.entity} collects, uses and protects your personal information.`;

/* A bullet line is authored as "• text" by the resolver rather than as nested
   data: one shape for every paragraph keeps the resolver testable as plain
   strings, and the page decides how a bullet looks. */
const isBullet = (s: string) => s.startsWith("• ");
---

<Layout title={title} description={description} pageType="other" robots="noindex,follow">
  <Header />
  <main>
    <Section id="privacy" bg="bg">
      <div class="legal-doc max-w-3xl">
        <h1 class="font-heading text-3xl font-semibold tracking-tight text-brand sm:text-4xl">
          Privacy policy
        </h1>
        {lastUpdated && <p class="mt-3 text-muted">Last updated: {lastUpdated}</p>}

        {policy.sections.length > 2 && (
          <nav class="legal-toc" aria-label="On this page">
            <p class="legal-toc-label">On this page</p>
            <ol class="legal-toc-list">
              {policy.sections.map((s: any) => (
                <li><a class="tap-target legal-toc-link" href={`#${s.id}`}>{s.heading}</a></li>
              ))}
            </ol>
          </nav>
        )}

        <div class="legal-body">
          {policy.sections.map((s: any) => (
            <section id={s.id} class="legal-section">
              <h2 class="legal-heading">{s.heading}</h2>
              {s.paragraphs.some(isBullet) ? (
                <Fragment>
                  {s.paragraphs.filter((t: string) => !isBullet(t)).map((t: string) => (
                    <p class="legal-para">{t}</p>
                  ))}
                  <ul class="legal-list">
                    {s.paragraphs.filter(isBullet).map((t: string) => (
                      <li class="legal-list-item">{t.slice(2)}</li>
                    ))}
                  </ul>
                </Fragment>
              ) : (
                s.paragraphs.map((t: string) => <p class="legal-para">{t}</p>)
              )}
            </section>
          ))}
        </div>
      </div>
    </Section>
  </main>
  <Footer />
</Layout>

<style>
  /* A legal page is read, not scanned — it gets a tighter measure and more
     space between sections than a marketing section would. */
  .legal-doc :is(h1, h2, p, li, a) { overflow-wrap: anywhere; }

  .legal-toc {
    margin-top: 2.5rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .legal-toc-label {
    margin: 0 0 0.75rem;
    font-family: var(--font-body);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .legal-toc-list {
    display: grid;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .legal-toc-list { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2rem; }
  }

  .legal-toc-link {
    display: flex;
    align-items: center;
    min-height: 2.25rem;
    font-family: var(--font-body);
    font-size: var(--text-small);
    line-height: 1.4;
    color: var(--color-brand);
    text-decoration: none;
    text-underline-offset: 4px;
  }

  .legal-toc-link:hover { text-decoration: underline; }

  .legal-body { margin-top: 2.5rem; }

  .legal-section { margin-top: 2.5rem; scroll-margin-top: 6rem; }
  .legal-section:first-child { margin-top: 0; }

  .legal-heading {
    margin: 0 0 0.75rem;
    font-family: var(--font-heading);
    font-size: var(--text-lead);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-brand);
  }

  .legal-para {
    margin: 0 0 0.875rem;
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: 1.7;
    color: var(--color-ink);
    max-width: 38em;
  }

  .legal-para:last-child { margin-bottom: 0; }

  .legal-list {
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
    max-width: 38em;
  }

  .legal-list-item {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--color-ink);
  }
</style>
